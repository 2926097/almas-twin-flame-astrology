{
  "schema_version": "1.0.0",
  "policy_id": "ALMAS_VALIDATION_PREREGISTRATION_BUNDLE_V1",
  "status": "FROZEN_EXPERIMENTAL_PROTOCOL",
  "epistemic_class": "E_PROJECT_POLICY",
  "purpose": "Congelar un paquete de validación externo antes de abrir cualquier holdout, sin almacenar muestras, resultados ni etiquetas observadas.",
  "allowed_targets": ["PX"],
  "allowed_null_models": ["PAIR_SHUFFLE", "MATCHED_AGE", "MATCHED_AGE_CLOCK"],
  "required_endpoint_ids": [
    "SPECIFICITY",
    "NEGATIVE_CONTROL_FALSE_SPECIFICITY",
    "ABLATION_STABILITY",
    "REPLICATION_STABILITY",
    "LEAKAGE_ZERO",
    "NO_POSTHOC_CHANGE"
  ],
  "forbidden_bundle_keys": [
    "samples",
    "sample_ref",
    "recurrence_snapshot",
    "candidate_scores",
    "holdout_results",
    "observed_distribution",
    "observed_value",
    "outcome_label",
    "holdout_label",
    "ground_truth_ontology",
    "expected_result",
    "posthoc_label",
    "posthoc_narrative",
    "private_birth_data",
    "private_case_data",
    "private_messages"
  ],
  "principles": {
    "candidate_must_be_frozen_for_validation": true,
    "holdout_must_be_unopened": true,
    "formula_ref_must_be_frozen": true,
    "development_holdout_separation_required": true,
    "endpoints_frozen_before_holdout": true,
    "success_failure_criteria_frozen_before_holdout": true,
    "blinding_plan_required": true,
    "leakage_audit_plan_required": true,
    "negative_controls_required": true,
    "ablation_plan_required": true,
    "independent_replication_plan_required": true,
    "raw_holdout_samples_forbidden": true,
    "observed_holdout_results_forbidden": true,
    "private_case_material_forbidden": true,
    "bundle_fingerprint_required": true,
    "automatic_registry_mutation_forbidden": true,
    "scoring_enabled": false,
    "weighting_enabled": false,
    "ontology_enabled": false,
    "l3_validation_enabled": false,
    "metaphysical_probability": false
  }
}