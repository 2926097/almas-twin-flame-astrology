    "PERSONAL_RELATIONAL": ["SUN", "MOON", "MERCURY", "VENUS", "MARS", "JUPITER", "AXIS_HORIZON"],
    "MEANINGFUL_COUNTERPART": ["SUN", "MOON", "MERCURY", "VENUS", "MARS", "JUPITER", "SATURN", "URANUS", "NEPTUNE", "PLUTO", "CHIRON", "AXIS_HORIZON", "AXIS_MERIDIAN", "AXIS_NODES"],
    "KARMIC_ANCHOR": ["AXIS_NODES", "SATURN"],
    "TRANSFORMATION_ANCHOR": ["PLUTO", "CHIRON", "URANUS"]
  },
  "relation_sets": {
    "MIRROR_HARD": ["OPPOSITION", "SQUARE", "CONTRA_PARALLEL", "CONTRA_ANTISCION"],
    "COHERENT": ["CONJUNCTION", "TRINE", "SEXTILE", "PARALLEL", "ANTISCION"]
  },
  "primary_rule_order": [
    "PK_KARMIC_CONTINUITY",
    "PT_TRANSFORMATION",
    "PE_MIRROR_COMPLEMENTARITY",
    "PR_RELATIONAL_COHERENCE",
    "PA_STRUCTURAL_AFFINITY"
  ],
  "rules": {
    "PK_KARMIC_CONTINUITY": {"pillar": "PK"},
    "PT_TRANSFORMATION": {"pillar": "PT"},
    "PE_MIRROR_COMPLEMENTARITY": {"pillar": "PE"},
    "PR_RELATIONAL_COHERENCE": {"pillar": "PR"},
    "PA_STRUCTURAL_AFFINITY": {"pillar": "PA"}
  },
  "singularity_rule": {
    "pillar": "PU",
    "state": "NOT_EVALUABLE",
    "reason": "La singularidad diádica no se atribuye automáticamente sin discriminador validado y preregistrado."
  }
}