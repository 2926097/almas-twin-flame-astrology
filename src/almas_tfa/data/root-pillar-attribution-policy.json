    "ps_recurrent_layer_derived_by_semantic_motif_graph": true,
    "support_only_can_feed_pillars": false,
    "pu_automatic_attribution_forbidden": true,
    "null_rarity_used_as_pillar": false,
    "temporal_activation_used_as_pillar": false,
    "missing_data_are_zero": false,
    "structural_absence_may_be_zero_only_with_complete_required_module_set": true
  },
  "required_modules_for_structural_absence": ["M03", "M05", "M06", "M09", "M11"],
  "point_sets": {
