{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/vedic.schema.json",
  "title": "ALMAS · Motor Jyotiṣa observacional",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ALMAS_VED_ENVELOPE_1"
    },
    "enabled": {
      "type": "boolean"
    },
    "canonical_effect": {
      "const": false
    },
    "external_validation": {
      "const": "NOT_PERFORMED"
    },
    "metaphysical_assessment": {
      "const": "INSUFFICIENT"
    },
    "charts": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/chart"
      }
    },
    "synastry": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/synastry"
        }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "temporal_readiness": {
      "type": "object",
      "required": [
        "status",
        "events_requested",
        "vimshottari_subject_results",
        "transit_events",
        "independent_temporal_roots",
        "event_prediction",
        "confirmatory_rule"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "DESCRIPTIVE_ONLY"
          ]
        },
        "events_requested": {
          "type": "integer",
          "minimum": 0
        },
        "vimshottari_subject_results": {
          "type": "integer",
          "minimum": 0
        },
        "transit_events": {
          "type": "integer",
          "minimum": 0
        },
        "independent_temporal_roots": {
          "const": 0
        },
        "event_prediction": {
          "const": false
        },
        "confirmatory_rule": {
          "const": "NOT_PREREGISTERED"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "sensitivity": {
      "type": "array"
    },
    "annual": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "return_source_ref": {
            "type": "string",
            "minLength": 1
          },
          "chart": {
            "$ref": "#/$defs/chart"
          },
          "vivaha_saham": {
            "type": "object",
            "properties": {
              "default_weight": {
                "const": 0
              },
              "context": {
                "const": "ANNUAL"
              }
            },
            "required": [
              "default_weight",
              "context"
            ]
          }
        },
        "required": [
          "return_source_ref",
          "chart",
          "vivaha_saham"
        ]
      }
    },
    "ablation": {
      "type": [
        "object",
        "null"
      ]
    },
    "shapley": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "enabled",
    "canonical_effect",
    "external_validation",
    "metaphysical_assessment",
    "charts",
    "synastry",
    "events",
    "temporal_readiness",
    "sensitivity",
    "annual",
    "ablation",
    "shapley"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "charts": {
            "minItems": 2
          },
          "synastry": {
            "$ref": "#/$defs/synastry"
          }
        }
      },
      "else": {
        "properties": {
          "charts": {
            "maxItems": 0
          },
          "synastry": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "chart": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "ALMAS_VED_1"
        },
        "canonical_effect": {
          "const": false
        },
        "configuration": {
          "type": "object"
        },
        "provenance": {
          "type": "object"
        },
        "birth": {
          "type": [
            "string",
            "null"
          ]
        },
        "d1": {
          "type": "object"
        },
        "d9": {
          "type": "object"
        },
        "karakas": {
          "type": "object"
        },
        "karakamsha": {
          "type": "object"
        },
        "arudhas": {
          "type": "object"
        },
        "bhrigu_bindu": {
          "type": "object"
        },
        "upagrahas": {
          "type": "object"
        },
        "confidence": {
          "type": "object"
        },
        "metaphysical_assessment": {
          "const": "INSUFFICIENT"
        },
        "abhijit_overlay": {
          "type": "object"
        },
        "solar_context": {
          "type": "object"
        },
        "time_upagrahas": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "canonical_effect",
        "configuration",
        "provenance",
        "birth",
        "d1",
        "d9",
        "karakas",
        "karakamsha",
        "arudhas",
        "bhrigu_bindu",
        "upagrahas",
        "confidence",
        "metaphysical_assessment"
      ],
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "required": [
        "feature_id",
        "object_a",
        "object_b",
        "varga_a",
        "varga_b",
        "root_dependency_id",
        "default_weight",
        "confidence",
        "empirical",
        "epistemic_class",
        "sign_relation",
        "angular_contacts_deg",
        "same_nakshatra",
        "same_sign",
        "input_dependencies",
        "redundancy_group",
        "orb_deg",
        "separation_deg"
      ],
      "properties": {
        "feature_id": {
          "type": "string",
          "pattern": "^VED[.]"
        },
        "default_weight": {
          "const": 0
        },
        "empirical": {
          "const": "NOT_PERFORMED"
        },
        "epistemic_class": {
          "const": "E_PROJECT_HYPOTHESIS"
        },
        "varga_a": {
          "enum": [
            "D1",
            "D9"
          ]
        },
        "varga_b": {
          "enum": [
            "D1",
            "D9"
          ]
        },
        "root_dependency_id": {
          "type": "string"
        },
        "separation_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 180
        },
        "confidence": {
          "type": "object"
        },
        "object_a": {
          "type": "string",
          "minLength": 1
        },
        "object_b": {
          "type": "string",
          "minLength": 1
        },
        "same_sign": {
          "type": "boolean"
        },
        "same_nakshatra": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sign_relation": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "angular_contacts_deg": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              0,
              60,
              90,
              120,
              180
            ]
          }
        },
        "orb_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "input_dependencies": {
          "type": "object",
          "properties": {
            "a": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "b": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "a",
            "b"
          ]
        },
        "redundancy_group": {
          "type": "string"
        }
      }
    },
    "synastry": {
      "type": "object",
      "required": [
        "schema_version",
        "canonical_effect",
        "features",
        "ived",
        "metaphysical_assessment",
        "configuration",
        "chart_hashes",
        "compatibility",
        "recurrence",
        "methodological_readiness",
        "counterevidence"
      ],
      "properties": {
        "schema_version": {
          "const": "ALMAS_VED_SYNASTRY_1"
        },
        "canonical_effect": {
          "const": false
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "metaphysical_assessment": {
          "const": "INSUFFICIENT"
        },
        "ived": {
          "type": "object",
          "properties": {
            "value": {
              "type": "null"
            },
            "status": {
              "const": "UNVALIDATED"
            },
            "family_weights": {
              "type": "null"
            }
          },
          "required": [
            "value",
            "status",
            "family_weights"
          ]
        },
        "methodological_readiness": {
          "type": "object",
          "required": [
            "descriptive",
            "independence",
            "ashtakuta",
            "ived"
          ],
          "properties": {
            "descriptive": {
              "type": "object",
              "required": [
                "feature_count",
                "match_count",
                "dependency_bundle_count",
                "match_rule",
                "bundle_rule"
              ]
            },
            "independence": {
              "type": "object",
              "required": [
                "status",
                "independent_root_count",
                "statistical_independence_demonstrated",
                "interpretation"
              ],
              "properties": {
                "status": {
                  "const": "NOT_ESTABLISHED"
                },
                "independent_root_count": {
                  "type": "null"
                },
                "statistical_independence_demonstrated": {
                  "const": false
                }
              },
              "additionalProperties": true
            },
            "ashtakuta": {
              "type": "object",
              "required": [
                "status",
                "total_score",
                "component_states",
                "verification"
              ],
              "properties": {
                "status": {
                  "const": "NOT_EVALUABLE"
                },
                "total_score": {
                  "type": "null"
                }
              }
            },
            "ived": {
              "type": "object",
              "required": [
                "status",
                "value",
                "family_weights",
                "gates",
                "blockers"
              ],
              "properties": {
                "status": {
                  "const": "UNVALIDATED"
                },
                "value": {
                  "type": "null"
                },
                "family_weights": {
                  "type": "null"
                },
                "gates": {
                  "type": "object",
                  "properties": {
                    "preregistered": {
                      "const": false
                    },
                    "calibrated": {
                      "const": false
                    },
                    "external_validation": {
                      "const": false
                    }
                  },
                  "required": [
                    "preregistered",
                    "calibrated",
                    "external_validation"
                  ],
                  "additionalProperties": false
                },
                "blockers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        },
        "configuration": {
          "type": "object"
        },
        "chart_hashes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "recurrence": {
          "type": "object",
          "properties": {
            "independent_root_count": {
              "type": "null"
            }
          },
          "required": [
            "raw_matches",
            "dependency_bundles",
            "independent_root_count"
          ]
        },
        "compatibility": {
          "type": "object",
          "properties": {
            "total_score": {
              "type": "null"
            },
            "matrimonial_assessment": {
              "const": "NOT_EVALUABLE"
            },
            "metaphysical_assessment": {
              "const": "INSUFFICIENT"
            }
          },
          "required": [
            "components",
            "total_score",
            "matrimonial_assessment",
            "metaphysical_assessment",
            "verification"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "event_timestamp": {
          "type": "string"
        },
        "persons": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "person": {
                "enum": [
                  "A",
                  "B"
                ]
              },
              "status": {
                "enum": [
                  "IMPLEMENTED",
                  "NOT_EVALUABLE"
                ]
              }
            },
            "required": [
              "person",
              "status"
            ]
          }
        },
        "transit_contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "person": {
                "enum": [
                  "A",
                  "B"
                ]
              },
              "target_longitude": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "angle": {
                "enum": [
                  0,
                  180
                ]
              },
              "residual_deg": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "structural_feature_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "root_dependency_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "person",
              "target_longitude",
              "transit",
              "angle",
              "residual_deg",
              "structural_feature_refs",
              "root_dependency_refs"
            ]
          }
        },
        "transit_status": {
          "enum": [
            "IMPLEMENTED",
            "NOT_PERFORMED"
          ]
        },
        "temporal_independent_root_count": {
          "const": 0
        },
        "canonical_effect": {
          "const": false
        },
        "epistemic_class": {
          "const": "E_PROJECT_HYPOTHESIS"
        },
        "predicts_event": {
          "const": false
        },
        "assessment": {
          "const": "INSUFFICIENT"
        },
        "confirmatory_temporal_rule": {
          "const": "NOT_PREREGISTERED"
        }
      },
      "required": [
        "event_id",
        "event_timestamp",
        "persons",
        "transit_contacts",
        "transit_status",
        "temporal_independent_root_count",
        "canonical_effect",
        "epistemic_class",
        "predicts_event",
        "assessment",
        "confirmatory_temporal_rule",
        "structural_anchor_count"
      ]
    }
  }
}
