{
  "schema_version": "1.0.0",
  "policy_id": "ALMAS_PX_V3_CANDIDATE_FREEZE_V1",
  "status": "FROZEN_EXPERIMENTAL_PROTOCOL",
  "epistemic_class": "E_PROJECT_POLICY",
  "purpose": "Definir el gate de congelación de candidatos PX v3 antes de cualquier evaluación holdout y sin habilitar scoring.",
  "allowed_statuses": [
    "DRAFT",
    "FROZEN_FOR_VALIDATION",
    "REJECTED"
  ],
  "allowed_targets": ["PX"],
  "allowed_descriptors": [
    "FAMILY_CLASS_COUNT",
    "CROSS_CLASS_RECURRENCE",
    "NON_DRACONIC_RECURRENCE",
    "FAMILY_STRENGTH_ENTROPY",
    "EFFECTIVE_FAMILY_COUNT",
    "FAMILY_DOMINANCE_SHARE",
    "LEAVE_ONE_FAMILY_OUT_SURVIVAL",
    "LEAVE_ONE_CLASS_OUT_SURVIVAL",
    "MOTIF_STRENGTH",
    "RECURRENCE_PRESENCE"
  ],
  "freeze_requirements": {
    "formula_frozen_before_holdout": true,
    "s2_refs_required": true,
    "s3_refs_required": true,
    "ablation_refs_required": true,
    "negative_control_refs_required": true,
    "falsification_criteria_required": true,
    "development_case_refs_required": true,
    "holdout_refs_must_be_empty_at_freeze": true,
    "holdout_fitted_thresholds_forbidden": true,
    "scoring_enabled_must_be_false": true,
    "ontology_enabled_must_be_false": true
  },
  "principles": {
    "case_fitting_forbidden": true,
    "development_cases_cannot_validate_candidate": true,
    "freeze_before_holdout": true,
    "runtime_registry_mutation_forbidden": true,
    "scoring_enabled": false,
    "weighting_enabled": false,
    "ontology_enabled": false,
    "l3_validation_enabled": false,
    "metaphysical_probability": false,
    "candidate_freeze_is_not_validation": true
  }
}