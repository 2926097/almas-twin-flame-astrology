{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ALMAS_PU_METAPHYSICAL_REQUEST_V1",
  "type": "object",
  "properties": {
    "model_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "TWIN_FLAME_MODEL",
          "SOULMATE_MODEL",
          "SOUL_FAMILY_GROUP",
          "MONADIC_COMMON_SOURCE",
          "SPLIT_SOUL",
          "ZIVUG"
        ]
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "value_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value_id",
          "model_id",
          "status",
          "epistemic_class",
          "evidence_refs",
          "dependency_group"
        ],
        "properties": {
          "value_id": {
            "enum": [
              "COUNTERPART_UNIQUENESS",
              "SHARED_IDENTITY",
              "PRIOR_UNITY",
              "POLARITY",
              "ACTIVATOR_SPECIFICITY",
              "SPIRITUAL_PURPOSE",
              "FUNCTIONAL_NONINTERCHANGEABILITY",
              "INTEGRATION_AUTONOMY"
            ]
          },
          "model_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "SUPPORTED",
              "COMPATIBLE",
              "INSUFFICIENT",
              "CONTRADICTED",
              "NOT_EVALUABLE"
            ]
          },
          "epistemic_class": {
            "enum": [
              "A_DOCUMENTARY",
              "D_CONTEMPORARY_USAGE",
              "E_PROJECT_HYPOTHESIS"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "dependency_group": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "target": {
      "$ref": "#/$defs/case"
    },
    "comparators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "comparison_policy": {
      "type": "object",
      "required": [
        "template",
        "weights",
        "equivalence_margin",
        "minimum_irc",
        "selection_record_ref"
      ],
      "properties": {
        "template": {
          "type": "object"
        },
        "weights": {
          "type": "object"
        },
        "equivalence_margin": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "minimum_irc": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "selection_record_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "preregistration": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "DRAFT",
            "DECLARED_FROZEN"
          ]
        },
        "comparison_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "record_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "canonical",
        "canonical_fingerprint",
        "subject_ids",
        "protocol"
      ],
      "properties": {
        "canonical": {
          "type": "object"
        },
        "canonical_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protocol": {
          "type": "object",
          "required": [
            "analysis_policy_fingerprint",
            "house_system",
            "time_quality",
            "signature_policy"
          ],
          "properties": {
            "analysis_policy_fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "house_system": {
              "type": "string"
            },
            "time_quality": {
              "type": "string"
            },
            "signature_policy": {
              "const": "CORE_PRIMARY_MOTIF_MAX_V1"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "title": "ALMAS · Solicitud de singularidad metafísica"
}
