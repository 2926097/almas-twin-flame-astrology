{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/doctrinal-genealogy.schema.json",
  "title": "ALMAS Doctrinal Genealogy",
  "type": "object",
  "required": [
    "genealogy_version",
    "almas_version",
    "edges"
  ],
  "properties": {
    "genealogy_version": {
      "type": "string"
    },
    "almas_version": {
      "type": "string"
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "relation",
          "status",
          "note"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "BROADER_TO_NARROWER",
              "COMPARATIVE_ANALOGUE",
              "COMPARATIVE_ANTECEDENT_ONLY",
              "COMPARATIVE_MOTIF_ONLY",
              "COMPETING_EXPLANATION",
              "COMPETING_OR_BROADER_HISTORY",
              "CONCEPTUAL_PRECONDITION",
              "CONTEXT_NOT_PROOF",
              "DIFFERENT_ANALYTICAL_AXIS",
              "DOCTRINAL_CONSTRAINT",
              "DOCTRINAL_NEIGHBOR_NOT_IDENTITY",
              "DOCTRINAL_OVERLAP",
              "DOCTRINAL_SPECIALIZATION",
              "DOCUMENTS_CIRCULATION",
              "EMIC_USAGE_TO_PROJECT_MODEL",
              "FRAMEWORK_CONTEXT",
              "FRAMEWORK_NOT_METHOD",
              "FUNCTIONAL_OVERLAP_NOT_DIAGNOSIS",
              "FUNCTION_NOT_CONTRACT_PROOF",
              "HISTORICAL_CONTEXT",
              "HISTORICAL_DOCTRINAL_RELATION",
              "INSUFFICIENT_FOR_BILATERAL_CONTRACT",
              "INSUFFICIENT_FOR_DYADIC_ORIGIN",
              "METHOD_GENEALOGY",
              "MODERN_REINTERPRETATION_NOT_IDENTITY",
              "MOTIF_OVERLAP",
              "NON_DISCRIMINATING_PHENOMENOLOGY",
              "NON_EQUIVALENT",
              "NON_EXCLUSIVE_NETWORK_VS_DYAD",
              "NO_DIRECT_DOCTRINAL_IDENTITY",
              "OUTCOME_CONSTRAINT",
              "PAIRING_NOT_CONTRACT",
              "PARALLEL_VICTORIAN_VOCABULARY",
              "PARTIAL_OVERLAP",
              "PHENOMENOLOGY_NOT_CAUSAL_PROOF",
              "PHENOMENOLOGY_NOT_ONTOLOGY",
              "POSSIBLE_FUNCTIONAL_OVERLAP",
              "PROJECT_OPERATIONALIZATION",
              "SELF_LABEL_NOT_DOCTRINAL_VERIFICATION",
              "TERMINOLOGICAL_ANTECEDENT_NOT_DOCTRINAL_IDENTITY"
            ]
          },
          "status": {
            "enum": [
              "SUPPORTED",
              "COMPATIBLE",
              "INSUFFICIENT",
              "CONTRADICTED",
              "NOT_EVALUABLE",
              "E_PROJECT_HYPOTHESIS"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
