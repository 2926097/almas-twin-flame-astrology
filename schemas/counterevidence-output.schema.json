{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/counterevidence-output.schema.json",
  "title": "ALMAS · Salida de contraevidencia",
  "type": "object",
  "required": [
    "models",
    "suppressed",
    "ice_state",
    "ice_by_model",
    "missing_data_penalized",
    "assessment_complete",
    "ice_formula_id",
    "ice_family_diagnostics"
  ],
  "properties": {
    "models": {
      "type": "object"
    },
    "suppressed": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ice_state": {
      "enum": [
        "PRECOMPUTED",
        "AUTONOMOUS",
        "NOT_CALCULATED"
      ]
    },
    "ice_by_model": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/iceByModel"
        }
      ]
    },
    "missing_data_penalized": {
      "const": false
    },
    "assessment_complete": {
      "type": "boolean"
    },
    "ice_formula_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "const": "ALMAS_ICE_AUTONOMOUS_V1"
        }
      ]
    },
    "ice_family_diagnostics": {
      "type": "object",
      "required": [
        "AF",
        "KA",
        "AG",
        "LG"
      ],
      "properties": {
        "AF": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dependency_family",
              "severity"
            ],
            "properties": {
              "dependency_family": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "KA": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dependency_family",
              "severity"
            ],
            "properties": {
              "dependency_family": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "AG": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dependency_family",
              "severity"
            ],
            "properties": {
              "dependency_family": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "LG": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dependency_family",
              "severity"
            ],
            "properties": {
              "dependency_family": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "iceByModel": {
      "type": "object",
      "required": [
        "AF",
        "KA",
        "AG",
        "LG"
      ],
      "properties": {
        "AF": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "KA": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "AG": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "LG": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ice_state": {
            "const": "PRECOMPUTED"
          }
        },
        "required": [
          "ice_state"
        ]
      },
      "then": {
        "properties": {
          "ice_by_model": {
            "$ref": "#/$defs/iceByModel"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ice_state": {
            "const": "NOT_CALCULATED"
          }
        },
        "required": [
          "ice_state"
        ]
      },
      "then": {
        "properties": {
          "ice_by_model": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ice_state": {
            "const": "AUTONOMOUS"
          }
        },
        "required": [
          "ice_state"
        ]
      },
      "then": {
        "properties": {
          "assessment_complete": {
            "const": true
          },
          "ice_formula_id": {
            "const": "ALMAS_ICE_AUTONOMOUS_V1"
          },
          "ice_by_model": {
            "$ref": "#/$defs/iceByModel"
          }
        }
      }
    }
  ]
}
