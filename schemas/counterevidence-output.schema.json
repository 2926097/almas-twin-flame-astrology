{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/counterevidence-output.schema.json",
  "title": "ALMAS · Salida de contraevidencia",
  "type": "object",
  "required": [
    "models",
    "suppressed",
    "ice_state",
    "ice_by_model",
    "missing_data_penalized"
  ],
  "properties": {
    "models": {
      "type": "object"
    },
    "suppressed": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ice_state": {
      "enum": [
        "PRECOMPUTED",
        "NOT_CALCULATED"
      ]
    },
    "ice_by_model": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/iceByModel"
        }
      ]
    },
    "missing_data_penalized": {
      "const": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "iceByModel": {
      "type": "object",
      "required": [
        "AF",
        "KA",
        "AG",
        "LG"
      ],
      "properties": {
        "AF": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "KA": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "AG": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "LG": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ice_state": {
            "const": "PRECOMPUTED"
          }
        },
        "required": [
          "ice_state"
        ]
      },
      "then": {
        "properties": {
          "ice_by_model": {
            "$ref": "#/$defs/iceByModel"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ice_state": {
            "const": "NOT_CALCULATED"
          }
        },
        "required": [
          "ice_state"
        ]
      },
      "then": {
        "properties": {
          "ice_by_model": {
            "type": "null"
          }
        }
      }
    }
  ]
}
