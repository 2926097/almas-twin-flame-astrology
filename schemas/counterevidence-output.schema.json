{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/counterevidence-output.schema.json",
  "title": "ALMAS · Salida de contraevidencia",
  "type": "object",
  "required": [
    "models",
    "suppressed",
    "ice_state",
    "ice_by_model",
    "counterevidence_complete",
    "ice_derivation",
    "missing_data_penalized"
  ],
  "properties": {
    "models": {
      "type": "object"
    },
    "suppressed": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ice_state": {
      "enum": [
        "PRECOMPUTED",
        "AUTONOMOUS",
        "NOT_CALCULATED"
      ]
    },
    "ice_by_model": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/iceByModel"
        }
      ]
    },
    "counterevidence_complete": {
      "type": "boolean"
    },
    "ice_derivation": {
      "$ref": "#/$defs/iceDerivation"
    },
    "missing_data_penalized": {
      "const": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "iceByModel": {
      "type": "object",
      "required": [
        "AF",
        "KA",
        "AG",
        "LG"
      ],
      "properties": {
        "AF": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "KA": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "AG": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "LG": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "iceDerivation": {
      "type": "object",
      "required": [
        "method",
        "formula",
        "dependency_control",
        "by_model"
      ],
      "properties": {
        "method": {
          "enum": [
            "PRECOMPUTED",
            "AUTONOMOUS_SEMANTIC_SATURATION_V1",
            "NOT_CALCULATED"
          ]
        },
        "formula": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependency_control": {
          "type": [
            "string",
            "null"
          ]
        },
        "by_model": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ice_state": {
            "enum": [
              "PRECOMPUTED",
              "AUTONOMOUS"
            ]
          }
        },
        "required": [
          "ice_state"
        ]
      },
      "then": {
        "properties": {
          "ice_by_model": {
            "$ref": "#/$defs/iceByModel"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ice_state": {
            "const": "AUTONOMOUS"
          }
        },
        "required": [
          "ice_state"
        ]
      },
      "then": {
        "properties": {
          "counterevidence_complete": {
            "const": true
          },
          "ice_derivation": {
            "properties": {
              "method": {
                "const": "AUTONOMOUS_SEMANTIC_SATURATION_V1"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ice_state": {
            "const": "NOT_CALCULATED"
          }
        },
        "required": [
          "ice_state"
        ]
      },
      "then": {
        "properties": {
          "ice_by_model": {
            "type": "null"
          }
        }
      }
    }
  ]
}
