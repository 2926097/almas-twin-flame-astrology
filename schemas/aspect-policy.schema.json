{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/aspect-policy.schema.json",
  "title": "ALMAS · Política explícita de aspectos y orbes",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "type": "string",
    "minLength": 1
  },
  "additionalProperties": {
    "type": "object",
    "required": ["angle", "orb"],
    "properties": {
      "angle": {
        "type": "number",
        "minimum": 0,
        "maximum": 180
      },
      "orb": {
        "type": "number",
        "minimum": 0
      }
    },
    "additionalProperties": false
  }
}
