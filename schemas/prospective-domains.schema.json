{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://almas.example/schemas/prospective-domains.schema.json",
  "title": "ALMAS · prerregistro prospectivo de dominios biográficos",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "preregistration_id", "registered_at", "observation_date", "actor_alias", "identity_linked_in_public_record", "preregistration_policy_id", "status", "epistemic_class", "domains_to_observe", "phase_mappings", "evidence_predeclared", "meeting_or_reunion_predeclared", "future_decisions_predicted", "causal_status", "ontology_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "preregistration_id": {"const": "ALMAS_PROSPECTIVE_DOMAINS_2027_03_29_V1"},
    "registered_at": {"const": "2026-09-30"}, "observation_date": {"const": "2027-03-29"}, "actor_alias": {"type": "string", "minLength": 1}, "identity_linked_in_public_record": {"const": false},
    "preregistration_policy_id": {"const": "ALMAS_1_22_PHASE_RULES_2026_09_30"}, "status": {"const": "FROZEN_BEFORE_OBSERVATION"}, "epistemic_class": {"const": "E_PROJECT_HYPOTHESIS"},
    "domains_to_observe": {"const": ["identity_restructuring", "reality_vs_ideal", "affective_revision", "individuation"]},
    "phase_mappings": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["phase_id", "status", "required_evidence_policy"], "properties": {"phase_id": {"enum": ["awakening_candidate", "surrender_candidate"]}, "status": {"const": "NOT_EVALUABLE"}, "required_evidence_policy": {"type": "string", "minLength": 1}}}},
    "evidence_predeclared": {"maxItems": 0, "type": "array"}, "meeting_or_reunion_predeclared": {"const": false}, "future_decisions_predicted": {"const": false}, "causal_status": {"const": "UNESTABLISHED"}, "ontology_status": {"const": "INSUFFICIENT"}
  }
}
