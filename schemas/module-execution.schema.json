{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/module-execution.schema.json",
  "title": "ALMAS · Resultado de ejecución modular",
  "type": "object",
  "required": [
    "module_id",
    "status",
    "payload",
    "canonical_updates",
    "evidence_refs",
    "limitations",
    "diagnostics"
  ],
  "properties": {
    "module_id": {
      "type": "string",
      "pattern": "^M(0[0-9]|[12][0-9]|3[01])$"
    },
    "status": {
      "enum": [
        "COMPLETED",
        "SKIPPED",
        "NOT_APPLICABLE",
        "NOT_EVALUABLE",
        "FAILED"
      ]
    },
    "payload": {
      "type": "object"
    },
    "canonical_updates": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
