{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/ontology-output.schema.json",
  "title": "ALMAS · Salida de ontología multiaxial",
  "type": "object",
  "required": [
    "schema_version",
    "axes",
    "cross_axis_checks"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "axes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "state",
          "categories",
          "evidence_refs",
          "reasoning"
        ],
        "properties": {
          "state": {
            "enum": [
              "SUPPORTED",
              "COMPATIBLE",
              "INSUFFICIENT",
              "CONTRADICTED",
              "NOT_EVALUABLE"
            ]
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counterevidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reasoning": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "cross_axis_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "passed"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
