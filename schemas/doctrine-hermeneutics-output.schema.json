{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/doctrine-hermeneutics-output.schema.json",
  "title": "ALMAS · Salida de doctrina y hermenéutica",
  "type": "object",
  "required": [
    "claims",
    "claim_count",
    "source_registry_mode",
    "source_registry_checked",
    "genealogy_checked",
    "unresolved_sources",
    "unresolved_anchors",
    "support_ref_issues",
    "epistemic_class_counts",
    "source_relation_counts",
    "source_priority_counts",
    "tradition_counts",
    "doctrine_adds_structural_score",
    "source_count_used_as_structural_weight",
    "epistemic_separation_enforced",
    "non_equivalence_enforced",
    "contemporary_usage_promoted_to_ontology",
    "project_hypothesis_promoted_to_doctrine",
    "cross_tradition_identity_inferred"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "claim_id",
          "statement",
          "epistemic_class",
          "claim_scope",
          "source_relation",
          "source_ids",
          "source_anchor_refs",
          "source_support_refs",
          "status",
          "allowed_conclusion",
          "inferential_ceiling",
          "ceiling_enforced",
          "source_audit",
          "traditions",
          "genealogy_checked",
          "genealogy_edges",
          "non_identity_genealogy_edges",
          "comparative_only",
          "doctrinal_identity_allowed",
          "project_construction",
          "contemporary_usage_promoted_to_ontology",
          "project_hypothesis_promoted_to_doctrine",
          "cross_tradition_identity_inferred",
          "doctrine_adds_structural_score"
        ],
        "properties": {
          "schema_version": {
            "const": "2.0.0"
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "epistemic_class": {
            "enum": [
              "A_CALCULATED",
              "B_TECHNIQUE",
              "C_DOCTRINE",
              "D_CONTEMPORARY_USAGE",
              "E_PROJECT_HYPOTHESIS"
            ]
          },
          "claim_scope": {
            "type": "string"
          },
          "source_relation": {
            "type": "string"
          },
          "source_audit": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "traditions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "genealogy_checked": {
            "type": "boolean"
          },
          "genealogy_edges": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "non_identity_genealogy_edges": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "comparative_only": {
            "type": "boolean"
          },
          "doctrinal_identity_allowed": {
            "type": "boolean"
          },
          "project_construction": {
            "type": "boolean"
          },
          "contemporary_usage_promoted_to_ontology": {
            "const": false
          },
          "project_hypothesis_promoted_to_doctrine": {
            "const": false
          },
          "cross_tradition_identity_inferred": {
            "const": false
          },
          "doctrine_adds_structural_score": {
            "const": false
          }
        },
        "additionalProperties": true
      }
    },
    "claim_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_registry_mode": {
      "enum": [
        "FULL_METADATA",
        "IDS_ONLY",
        "ABSENT"
      ]
    },
    "source_registry_checked": {
      "type": "boolean"
    },
    "genealogy_checked": {
      "type": "boolean"
    },
    "unresolved_sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unresolved_anchors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "support_ref_issues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "epistemic_class_counts": {
      "type": "object"
    },
    "source_relation_counts": {
      "type": "object"
    },
    "source_priority_counts": {
      "type": "object"
    },
    "tradition_counts": {
      "type": "object"
    },
    "doctrine_adds_structural_score": {
      "const": false
    },
    "source_count_used_as_structural_weight": {
      "const": false
    },
    "epistemic_separation_enforced": {
      "const": true
    },
    "non_equivalence_enforced": {
      "const": true
    },
    "contemporary_usage_promoted_to_ontology": {
      "const": false
    },
    "project_hypothesis_promoted_to_doctrine": {
      "const": false
    },
    "cross_tradition_identity_inferred": {
      "const": false
    }
  },
  "additionalProperties": false
}
