{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/temporal-sequence-graph.schema.json",
  "title": "ALMAS · Grafo de secuencia temporal",
  "type": "object",
  "required": ["status", "nodes", "edges", "unresolved", "missing_phases_inferred", "causal_status"],
  "properties": {
    "status": {"enum": ["READY", "NOT_EVALUABLE"]},
    "nodes": {"type": "array", "items": {"type": "object", "required": ["node_id", "kind", "evidence_refs"], "properties": {"node_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["EVENT", "ACTIVATION", "ROOT", "PHASE"]}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["source_id", "target_id", "evidence_refs"], "properties": {"source_id": {"type": "string"}, "target_id": {"type": "string"}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "missing_phases_inferred": {"const": false},
    "causal_status": {"const": "UNESTABLISHED"}
  },
  "additionalProperties": false
}
