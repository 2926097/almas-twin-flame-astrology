{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/validation-preregistration-bundle.schema.json",
  "title": "ALMAS · Validation Preregistration Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "policy_status",
    "epistemic_class",
    "validation_id",
    "preregistration_ref",
    "frozen_almas_version",
    "frozen_commit_sha",
    "candidate",
    "cohort_plan",
    "blinding_plan_ref",
    "leakage_audit_plan_ref",
    "independent_replication_plan_refs",
    "negative_control_refs",
    "ablation_refs",
    "planned_holdout_refs",
    "endpoints",
    "holdout_opened",
    "observed_results_present",
    "raw_samples_present",
    "automatic_registry_mutation",
    "scoring_enabled",
    "weighting_enabled",
    "ontology_enabled",
    "l3_validation",
    "metaphysical_probability"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"const": "ALMAS_VALIDATION_PREREGISTRATION_BUNDLE_V1"},
    "policy_status": {"type": "string"},
    "epistemic_class": {"const": "E_PROJECT_POLICY"},
    "validation_id": {"type": "string", "minLength": 1},
    "preregistration_ref": {"type": "string", "minLength": 1},
    "frozen_almas_version": {"type": "string", "minLength": 1},
    "frozen_commit_sha": {"type": "string", "minLength": 7},
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "target",
        "descriptor_ids",
        "formula_ref",
        "expected_direction",
        "development_case_refs",
        "frozen_for_validation"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "target": {"const": "PX"},
        "descriptor_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "formula_ref": {"type": "string", "minLength": 1},
        "expected_direction": {"type": "string", "minLength": 1},
        "development_case_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "frozen_for_validation": {"const": true}
      },
      "additionalProperties": false
    },
    "cohort_plan": {
      "type": "object",
      "required": [
        "cohort_id",
        "null_model",
        "feature_set_ref",
        "orb_policy_ref",
        "pairing_rule_ref",
        "inclusion_rule_ref",
        "planned_min_samples"
      ],
      "properties": {
        "cohort_id": {"type": "string", "minLength": 1},
        "null_model": {
          "enum": ["PAIR_SHUFFLE", "MATCHED_AGE", "MATCHED_AGE_CLOCK"]
        },
        "feature_set_ref": {"type": "string", "minLength": 1},
        "orb_policy_ref": {"type": "string", "minLength": 1},
        "pairing_rule_ref": {"type": "string", "minLength": 1},
        "inclusion_rule_ref": {"type": "string", "minLength": 1},
        "planned_min_samples": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "blinding_plan_ref": {"type": "string", "minLength": 1},
    "leakage_audit_plan_ref": {"type": "string", "minLength": 1},
    "independent_replication_plan_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "negative_control_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "ablation_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "planned_holdout_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "endpoints": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "endpoint_id",
          "success_criterion",
          "failure_criterion"
        ],
        "properties": {
          "endpoint_id": {"type": "string", "minLength": 1},
          "success_criterion": {"type": "string", "minLength": 1},
          "failure_criterion": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "holdout_opened": {"const": false},
    "observed_results_present": {"const": false},
    "raw_samples_present": {"const": false},
    "automatic_registry_mutation": {"const": false},
    "scoring_enabled": {"const": false},
    "weighting_enabled": {"const": false},
    "ontology_enabled": {"const": false},
    "l3_validation": {"const": false},
    "metaphysical_probability": {"const": false}
  },
  "additionalProperties": false
}