{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/clause-assembly.schema.json",
  "title": "ALMAS Soul Contract Clause Assembly",
  "type": "object",
  "required": [
    "schema_version",
    "overall_state",
    "essential_clauses",
    "primary_clauses",
    "secondary_clauses",
    "clauses",
    "overlap_matrix",
    "evidence_families",
    "discriminators",
    "counterevidence",
    "vertical_coherence",
    "why_not_more_specific"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "overall_state": {
      "enum": [
        "SUPPORTED",
        "COMPATIBLE",
        "INSUFFICIENT",
        "CONTRADICTED",
        "NOT_EVALUABLE"
      ]
    },
    "essential_clauses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "primary_clauses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "secondary_clauses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "centrality",
          "direction",
          "genealogy",
          "astrology_root_refs",
          "function",
          "soul_objective",
          "shadow",
          "integration_requirement",
          "fulfillment_signature",
          "temporal_state",
          "reason_not_higher",
          "resolution_level",
          "reconstructed_contract_content",
          "activation_mechanism",
          "contract_test",
          "claim_refs",
          "allowed_conclusion",
          "inferential_ceiling"
        ],
        "properties": {
          "id": {
            "enum": [
              "CL_ENCUENTRO_RECONOCIMIENTO",
              "CL_VINCULO_AMOROSO",
              "CL_HERIDA_REPARACION",
              "CL_LIBERTAD_AUTONOMIA",
              "CL_COMUNICACION_VERDAD",
              "CL_TRANSFORMACION_PODER",
              "CL_INTEGRACION_ENCARNACION",
              "CL_LIBERACION_CIERRE"
            ]
          },
          "state": {
            "enum": [
              "SUPPORTED",
              "COMPATIBLE",
              "INSUFFICIENT",
              "CONTRADICTED",
              "NOT_EVALUABLE"
            ]
          },
          "centrality": {
            "enum": [
              "ESSENTIAL",
              "PRIMARY",
              "SECONDARY",
              "CORROBORATIVE",
              "INSUFFICIENT",
              "NOT_EVALUABLE"
            ]
          },
          "direction": {
            "enum": [
              "A_EN_B",
              "B_EN_A",
              "CAMPO_COMUN",
              "BILATERAL",
              "NO_EVALUABLE"
            ]
          },
          "genealogy": {
            "type": "object",
            "required": [
              "motive_refs",
              "role_refs",
              "individual_task_refs",
              "common_task_refs"
            ],
            "properties": {
              "origin_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "motive_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "role_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "encounter_condition_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "individual_task_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "common_task_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "astrology_root_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "function": {
            "type": "string"
          },
          "soul_objective": {
            "type": "string"
          },
          "learning": {
            "type": [
              "string",
              "null"
            ]
          },
          "shadow": {
            "type": "string"
          },
          "integration_requirement": {
            "type": "string"
          },
          "fulfillment_signature": {
            "type": "string"
          },
          "temporal_state": {
            "enum": [
              "LATENTE",
              "ACTIVADA",
              "EN_DESARROLLO",
              "INTEGRADA",
              "TRANSFORMADA",
              "CERRADA",
              "NO_EVALUABLE"
            ]
          },
          "coverage": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "robustness": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "r_min": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "counterevidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason_not_higher": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolution_level": {
            "enum": [
              "R0_NOT_EVALUABLE",
              "R1_PREINCARNATIONAL_THEME",
              "R2_RELATIONAL_PREINCARNATIONAL_FUNCTION",
              "R3_BILATERAL_AGREEMENT_MODEL",
              "R4_LITERAL_CONTENT"
            ]
          },
          "reconstructed_contract_content": {
            "type": "string"
          },
          "activation_mechanism": {
            "type": "string"
          },
          "contract_test": {
            "type": "string"
          },
          "claim_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "allowed_conclusion": {
            "type": "string"
          },
          "inferential_ceiling": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "overlap_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "a",
          "b",
          "relation"
        ],
        "properties": {
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "MERGE_CANDIDATE",
              "DISTINCT_BUT_DEPENDENT",
              "DISTINCT_INDEPENDENT",
              "NOT_EVALUABLE"
            ]
          }
        }
      }
    },
    "evidence_families": {
      "type": "array",
      "items": {
        "enum": [
          "CLF1_GENEALOGIA_VERTICAL",
          "CLF2_RAICES_ESTRUCTURALES",
          "CLF3_DIRECCIONALIDAD",
          "CLF4_ALINEACION_ROL_TAREA",
          "CLF5_ALINEACION_TAREA_COMUN",
          "CLF6_ANCLAJE_TEMPORAL",
          "CLF7_CONTRAEVIDENCIA",
          "CLF8_ROBUSTEZ"
        ]
      },
      "uniqueItems": true
    },
    "discriminators": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "robustness": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "vertical_coherence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "why_selected": {
      "type": [
        "string",
        "null"
      ]
    },
    "why_not_more_specific": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
