{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/external-recurrence-control-cohort.schema.json",
  "title": "ALMAS · Cohorte externa de control de recurrencia",
  "type": "object",
  "required": [
    "cohort_id",
    "preregistration_ref",
    "null_model",
    "frozen_almas_version",
    "frozen_commit_sha",
    "feature_set_ref",
    "orb_policy_ref",
    "pairing_rule_ref",
    "inclusion_rule_ref",
    "samples"
  ],
  "properties": {
    "cohort_id": {"type": "string", "minLength": 1},
    "preregistration_ref": {"type": "string", "minLength": 1},
    "null_model": {
      "enum": ["PAIR_SHUFFLE", "MATCHED_AGE", "MATCHED_AGE_CLOCK"]
    },
    "frozen_almas_version": {"type": "string", "minLength": 1},
    "frozen_commit_sha": {"type": "string", "minLength": 7},
    "feature_set_ref": {"type": "string", "minLength": 1},
    "orb_policy_ref": {"type": "string", "minLength": 1},
    "pairing_rule_ref": {"type": "string", "minLength": 1},
    "inclusion_rule_ref": {"type": "string", "minLength": 1},
    "leakage_audit_ref": {"type": ["string", "null"]},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sample_ref",
          "validation_status",
          "selection_status",
          "label_blinding",
          "contamination",
          "forbidden_field_hits",
          "label_leakage_count",
          "narrative_leakage_count",
          "case_fitting_count",
          "recurrence_snapshot"
        ],
        "properties": {
          "sample_ref": {"type": "string", "minLength": 1},
          "validation_status": {
            "enum": [
              "DEVELOPMENT_ONLY",
              "INTERNAL_REPLICATION",
              "EXTERNAL_HOLDOUT",
              "FROZEN_CONFIRMATORY"
            ]
          },
          "selection_status": {
            "enum": ["PREREGISTERED", "POST_HOC"]
          },
          "label_blinding": {
            "enum": [
              "BLINDED",
              "PARTIALLY_BLINDED",
              "UNBLINDED",
              "NOT_APPLICABLE"
            ]
          },
          "contamination": {"type": "boolean"},
          "forbidden_field_hits": {"type": "integer", "minimum": 0},
          "label_leakage_count": {"type": "integer", "minimum": 0},
          "narrative_leakage_count": {"type": "integer", "minimum": 0},
          "case_fitting_count": {"type": "integer", "minimum": 0},
          "recurrence_snapshot": {
            "type": "object",
            "required": ["pillar_attribution"],
            "properties": {
              "pillar_attribution": {
                "type": "object",
                "required": ["semantic_motifs", "recurrence_quality"],
                "properties": {
                  "semantic_motifs": {"type": "object"},
                  "recurrence_quality": {"type": "object"}
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}