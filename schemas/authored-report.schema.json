{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/authored-report.schema.json",
  "title": "ALMAS · Informe interpretativo redactado",
  "type": "object",
  "required": [
    "schema_version",
    "document_kind",
    "language",
    "canonical_fingerprint",
    "report_state",
    "interpretive_center",
    "technical_role",
    "metaphysical_scientific_validation_claimed",
    "canonical_values_mutated",
    "new_calculations_performed",
    "new_scores_created",
    "sections",
    "bibliography"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_kind": {"const": "ALMAS_AUTHORED_REPORT"},
    "language": {"const": "es"},
    "canonical_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "report_state": {"enum": ["READY", "PARTIAL"]},
    "interpretive_center": {
      "const": "ASTROLOGY_AND_SOURCE_BASED_METAPHYSICAL_HERMENEUTICS"
    },
    "technical_role": {
      "const": "CALCULATION_TRACEABILITY_AND_QUALITY_CONTROL"
    },
    "metaphysical_scientific_validation_claimed": {"const": false},
    "canonical_values_mutated": {"const": false},
    "new_calculations_performed": {"const": false},
    "new_scores_created": {"const": false},
    "sections": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "title",
          "authoring_state",
          "narrative",
          "canonical_paths_used",
          "epistemic_classes_used",
          "doctrinal_claim_refs",
          "evidence_refs",
          "source_refs",
          "limitations"
        ],
        "properties": {
          "section_id": {
            "enum": [
              "S01_SYNTHESIS",
              "S02_DATA_METHOD",
              "S03_NUMERIC_ONTOLOGY",
              "S04_STRUCTURE",
              "S05_RELATIONAL",
              "S06_DIFFERENTIAL",
              "S07_TEMPORAL",
              "S08_ROBUSTNESS",
              "S09_DOCTRINE",
              "S10_FINAL_SYNTHESIS",
              "S11_SOURCES_APPENDICES"
            ]
          },
          "title": {"type": "string", "minLength": 1},
          "authoring_state": {
            "enum": ["AUTHORED", "OMITTED_NOT_AVAILABLE"]
          },
          "narrative": {"type": "string"},
          "canonical_paths_used": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "epistemic_classes_used": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "A_CALCULATED",
                "B_TECHNIQUE",
                "C_DOCTRINE",
                "D_CONTEMPORARY_USAGE",
                "E_PROJECT_HYPOTHESIS"
              ]
            }
          },
          "doctrinal_claim_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "authoring_state": {"const": "AUTHORED"}
              },
              "required": ["authoring_state"]
            },
            "then": {
              "properties": {
                "narrative": {"minLength": 1},
                "canonical_paths_used": {"minItems": 1}
              }
            }
          },
          {
            "if": {
              "properties": {
                "authoring_state": {"const": "OMITTED_NOT_AVAILABLE"}
              },
              "required": ["authoring_state"]
            },
            "then": {
              "properties": {
                "narrative": {"maxLength": 0},
                "canonical_paths_used": {"maxItems": 0},
                "epistemic_classes_used": {"maxItems": 0},
                "doctrinal_claim_refs": {"maxItems": 0},
                "evidence_refs": {"maxItems": 0},
                "source_refs": {"maxItems": 0}
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "bibliography": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "citation_label",
          "source_scope"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "citation_label": {"type": "string", "minLength": 1},
          "source_scope": {
            "enum": [
              "DOCTRINE",
              "TECHNIQUE",
              "ACADEMIC",
              "CONTEMPORARY",
              "OTHER_VERIFIED"
            ]
          },
          "author": {"type": ["string", "null"]},
          "work": {"type": ["string", "null"]},
          "tradition": {"type": ["string", "null"]},
          "locator": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"]},
          "verification_anchor": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
