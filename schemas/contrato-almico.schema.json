{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrato álmico ALMAS",
  "type": "object",
  "required": [
    "version",
    "estado_global",
    "reciprocidad",
    "clausulas",
    "tiempos"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "estado_global": {
      "enum": [
        "SUPPORTED",
        "COMPATIBLE",
        "INSUFFICIENT",
        "CONTRADICTED",
        "NOT_EVALUABLE"
      ]
    },
    "reciprocidad": {
      "enum": [
        "BILATERAL",
        "PARCIAL",
        "ASIMETRICA",
        "NO_EVALUABLE"
      ]
    },
    "clausulas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "nombre",
          "estado",
          "direccion",
          "raices",
          "accion_simbolica",
          "requisito_integracion",
          "firma_cumplimiento"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "estado": {
            "enum": [
              "SUPPORTED",
              "COMPATIBLE",
              "INSUFFICIENT",
              "CONTRADICTED",
              "NOT_EVALUABLE"
            ]
          },
          "direccion": {
            "enum": [
              "A_EN_B",
              "B_EN_A",
              "CAMPO_COMUN",
              "BILATERAL"
            ]
          },
          "raices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tecnicas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencias": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accion_simbolica": {
            "type": "string"
          },
          "aprendizaje": {
            "type": "string"
          },
          "sombra": {
            "type": "string"
          },
          "requisito_integracion": {
            "type": "string"
          },
          "firma_cumplimiento": {
            "type": "string"
          },
          "alternativas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contraevidencia": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "robustez": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "estado_temporal": {
            "enum": [
              "LATENTE",
              "ACTIVADA",
              "EN_DESARROLLO",
              "INTEGRADA",
              "TRANSFORMADA",
              "CERRADA",
              "NO_EVALUABLE"
            ]
          },
          "tiempo_observacion": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidencia_hechos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tiempos": {
      "type": "object",
      "required": [
        "activacion_inicial",
        "desarrollo_clausulas",
        "cumplimiento_transformacion_cierre"
      ],
      "properties": {
        "activacion_inicial": {
          "type": "object"
        },
        "desarrollo_clausulas": {
          "type": "object"
        },
        "cumplimiento_transformacion_cierre": {
          "type": "object"
        }
      }
    },
    "roles_preencarnatorios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "origen",
          "receptor",
          "clausula",
          "rol_funcional",
          "intensidad",
          "radix_receptor",
          "factores_activadores",
          "significado_funcional"
        ],
        "properties": {
          "origen": {
            "type": "string"
          },
          "receptor": {
            "type": "string"
          },
          "clausula": {
            "type": "string"
          },
          "rol_funcional": {
            "enum": [
              "ACTIVADOR",
              "CATALIZADOR",
              "ESPEJO",
              "MEMORIA",
              "ESTRUCTURADOR",
              "LIBERADOR",
              "CONFRONTADOR",
              "PORTADOR_DE_VULNERABILIDAD",
              "INTEGRADOR",
              "MEDIADOR",
              "TESTIGO",
              "COMPANERO_DE_APRENDIZAJE"
            ]
          },
          "intensidad": {
            "enum": [
              "PRIMARIO",
              "SECUNDARIO",
              "CORROBORATIVO",
              "INSUFICIENTE",
              "NO_EVALUABLE"
            ]
          },
          "radix_receptor": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "factores_activadores": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "raices_independientes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tecnicas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencias": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "significado_funcional": {
            "type": "string"
          },
          "sombra": {
            "type": "string"
          },
          "requisito_integracion": {
            "type": "string"
          },
          "alternativa_competidora": {
            "type": "string"
          },
          "robustez_horaria": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    }
  }
}
