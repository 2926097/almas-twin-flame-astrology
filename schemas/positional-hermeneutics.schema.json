{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/positional-hermeneutics.schema.json",
  "title": "ALMAS · Ficha posicional hermenéutica",
  "type": "object",
  "required": ["point_id", "longitude", "sign", "sign_index", "degree_in_sign", "zodiac", "house", "house_system", "house_state", "decan", "sign_rulers", "dispositor_chains", "motion"],
  "properties": {
    "point_id": {"type": "string", "minLength": 1},
    "point_type": {"type": ["string", "null"]},
    "longitude": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
    "sign": {"type": "string"},
    "sign_index": {"type": "integer", "minimum": 0, "maximum": 11},
    "degree_in_sign": {"type": "number", "minimum": 0, "exclusiveMaximum": 30},
    "zodiac": {"type": "string"},
    "house": {"type": ["integer", "null"], "minimum": 1, "maximum": 12},
    "house_system": {"type": ["string", "null"]},
    "house_state": {"enum": ["AVAILABLE", "SYSTEM_UNSPECIFIED", "NOT_EVALUABLE"]},
    "decan": {
      "type": "object",
      "required": ["number", "start_degree", "end_degree_exclusive", "system_id", "rulers", "ruler_policy_id", "ruler_state", "ruler_profile_refs"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 3},
        "start_degree": {"type": "number", "enum": [0, 10, 20]},
        "end_degree_exclusive": {"type": "number", "enum": [10, 20, 30]},
        "system_id": {"const": "SIGN_TEN_DEGREE_SEGMENTS_V1"},
        "rulers": {"type": "array", "items": {"type": "string"}},
        "ruler_policy_id": {"type": ["string", "null"]},
        "ruler_source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "ruler_state": {"enum": ["DECLARED", "NOT_DECLARED"]},
        "ruler_profile_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "sign_rulers": {
      "type": "object",
      "required": ["rulers", "policy_id", "state", "ruler_profile_refs"],
      "properties": {
        "rulers": {"type": "array", "items": {"type": "string"}},
        "policy_id": {"type": ["string", "null"]},
        "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "state": {"enum": ["DECLARED", "NOT_DECLARED"]},
        "ruler_profile_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "dispositor_chains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "state"],
        "properties": {
          "path": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "state": {"enum": ["SELF_DISPOSITOR", "CYCLE", "UNRESOLVED", "MAX_DEPTH", "MAX_BRANCHES"]}
        },
        "additionalProperties": false
      }
    },
    "motion": {
      "type": "object",
      "required": ["state", "speed", "station_state", "interpretation_state"],
      "properties": {
        "state": {"enum": ["DIRECT", "RETROGRADE", "NOT_APPLICABLE", "NOT_EVALUABLE"]},
        "speed": {"type": ["number", "null"]},
        "station_state": {"const": "NOT_EVALUATED"},
        "interpretation_state": {"const": "NOT_AUTHORED"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
