{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/vedic.schema.json",
  "title": "ALMAS · Motor Jyotiṣa observacional",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ALMAS_VED_ENVELOPE_1"
    },
    "enabled": {
      "type": "boolean"
    },
    "canonical_effect": {
      "const": false
    },
    "external_validation": {
      "const": "NOT_PERFORMED"
    },
    "metaphysical_assessment": {
      "const": "INSUFFICIENT"
    },
    "charts": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/chart"
      }
    },
    "synastry": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/synastry"
        }
      ]
    },
    "events": {
      "type": "array"
    },
    "temporal_readiness": {
      "type": "object",
      "required": ["status", "events_requested", "vimshottari_subject_results", "transit_events", "independent_temporal_roots", "event_prediction", "confirmatory_rule"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "DESCRIPTIVE_ONLY"]},
        "events_requested": {"type": "integer", "minimum": 0},
        "vimshottari_subject_results": {"type": "integer", "minimum": 0},
        "transit_events": {"type": "integer", "minimum": 0},
        "independent_temporal_roots": {"const": 0},
        "event_prediction": {"const": false},
        "confirmatory_rule": {"const": "NOT_PREREGISTERED"},
        "blockers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "sensitivity": {
      "type": "array"
    },
    "annual": {
      "type": "array"
    },
    "ablation": {
      "type": [
        "object",
        "null"
      ]
    },
    "shapley": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "enabled",
    "canonical_effect",
    "external_validation",
    "metaphysical_assessment",
    "charts",
    "synastry",
    "events",
    "temporal_readiness",
    "sensitivity",
    "annual",
    "ablation",
    "shapley"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "charts": {
            "minItems": 2
          },
          "synastry": {
            "$ref": "#/$defs/synastry"
          }
        }
      },
      "else": {
        "properties": {
          "charts": {
            "maxItems": 0
          },
          "synastry": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "chart": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "ALMAS_VED_1"
        },
        "canonical_effect": {
          "const": false
        },
        "configuration": {
          "type": "object"
        },
        "provenance": {
          "type": "object"
        },
        "birth": {
          "type": [
            "string",
            "null"
          ]
        },
        "d1": {
          "type": "object"
        },
        "d9": {
          "type": "object"
        },
        "karakas": {
          "type": "object"
        },
        "karakamsha": {
          "type": "object"
        },
        "arudhas": {
          "type": "object"
        },
        "bhrigu_bindu": {
          "type": "object"
        },
        "upagrahas": {
          "type": "object"
        },
        "confidence": {
          "type": "object"
        },
        "metaphysical_assessment": {
          "const": "INSUFFICIENT"
        },
        "abhijit_overlay": {
          "type": "object"
        },
        "solar_context": {
          "type": "object"
        },
        "time_upagrahas": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "canonical_effect",
        "configuration",
        "provenance",
        "birth",
        "d1",
        "d9",
        "karakas",
        "karakamsha",
        "arudhas",
        "bhrigu_bindu",
        "upagrahas",
        "confidence",
        "metaphysical_assessment"
      ],
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "required": [
        "feature_id",
        "object_a",
        "object_b",
        "varga_a",
        "varga_b",
        "root_dependency_id",
        "default_weight",
        "confidence",
        "empirical",
        "epistemic_class"
      ],
      "properties": {
        "feature_id": {
          "type": "string",
          "pattern": "^VED[.]"
        },
        "default_weight": {
          "const": 0
        },
        "empirical": {
          "const": "NOT_PERFORMED"
        },
        "epistemic_class": {
          "const": "E_PROJECT_HYPOTHESIS"
        },
        "varga_a": {
          "enum": [
            "D1",
            "D9"
          ]
        },
        "varga_b": {
          "enum": [
            "D1",
            "D9"
          ]
        },
        "root_dependency_id": {
          "type": "string"
        },
        "separation_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 180
        },
        "confidence": {
          "type": "object"
        }
      }
    },
    "synastry": {
      "type": "object",
      "required": [
        "schema_version",
        "canonical_effect",
        "features",
        "ived",
        "metaphysical_assessment"
      ],
      "properties": {
        "schema_version": {
          "const": "ALMAS_VED_SYNASTRY_1"
        },
        "canonical_effect": {
          "const": false
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "metaphysical_assessment": {
          "const": "INSUFFICIENT"
        },
        "ived": {
          "type": "object",
          "properties": {
            "value": {
              "type": "null"
            },
            "status": {
              "const": "UNVALIDATED"
            }
          },
          "required": [
            "value",
            "status"
          ]
        },
        "methodological_readiness": {
          "type": "object",
          "required": ["descriptive", "independence", "ashtakuta", "ived"],
          "properties": {
            "descriptive": {"type": "object", "required": ["feature_count", "match_count", "dependency_bundle_count", "match_rule", "bundle_rule"]},
            "independence": {"type": "object", "required": ["status", "independent_root_count", "statistical_independence_demonstrated", "interpretation"], "properties": {"status": {"const": "NOT_ESTABLISHED"}, "independent_root_count": {"type": "null"}, "statistical_independence_demonstrated": {"const": false}}, "additionalProperties": true},
            "ashtakuta": {"type": "object", "required": ["status", "total_score", "component_states", "verification"], "properties": {"status": {"const": "NOT_EVALUABLE"}, "total_score": {"type": "null"}}},
            "ived": {"type": "object", "required": ["status", "value", "family_weights", "gates", "blockers"], "properties": {"status": {"const": "UNVALIDATED"}, "value": {"type": "null"}, "family_weights": {"type": "null"}, "gates": {"type": "object", "properties": {"preregistered": {"const": false}, "calibrated": {"const": false}, "external_validation": {"const": false}}, "required": ["preregistered", "calibrated", "external_validation"], "additionalProperties": false}, "blockers": {"type": "array", "items": {"type": "string"}}}}
          },
          "additionalProperties": false
        }
      }
    }
  }
}
