{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/personal-report-request.schema.json",
  "title": "ALMAS · Solicitud de informe astrológico personal",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "report_profile"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "subject": {
      "type": "object",
      "required": [
        "id",
        "birth_date",
        "time_reliability"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "display_name": {"type": ["string", "null"]},
        "birth_date": {
          "type": "string",
          "format": "date"
        },
        "birth_time": {
          "type": ["string", "null"],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$"
        },
        "timezone": {"type": ["string", "null"]},
        "place": {"type": ["string", "null"]},
        "latitude": {
          "type": ["number", "null"],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": ["number", "null"],
          "minimum": -180,
          "maximum": 180
        },
        "time_reliability": {
          "enum": ["A", "B", "C", "D"]
        },
        "birth_time_source_class": {
          "enum": [
            "DOCUMENTARY",
            "REPORTED",
            "RECTIFIED",
            "UNKNOWN",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "report_profile": {
      "enum": [
        "EXECUTIVE_PERSONAL_REPORT",
        "STANDARD_PERSONAL_REPORT",
        "FULL_CRITICAL_REPORT",
        "TECHNICAL_ATLAS",
        "ESOTERIC_KABBALISTIC_REPORT"
      ]
    }
  },
  "additionalProperties": false
}
