{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/personal-report-request.schema.json",
  "title": "ALMAS · Solicitud de informe astrológico personal",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "report_profile"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "subject": {
      "type": "object",
      "required": [
        "id",
        "birth_date",
        "time_reliability"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "display_name": {"type": ["string", "null"]},
        "birth_date": {
          "type": "string",
          "format": "date"
        },
        "birth_time": {
          "type": ["string", "null"],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$"
        },
        "timezone": {"type": ["string", "null"]},
        "place": {"type": ["string", "null"]},
        "latitude": {
          "type": ["number", "null"],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": ["number", "null"],
          "minimum": -180,
          "maximum": 180
        },
        "time_reliability": {
          "enum": ["A", "B", "C", "D"]
        },
        "birth_time_source_class": {
          "enum": [
            "DOCUMENTARY",
            "REPORTED",
            "RECTIFIED",
            "UNKNOWN",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "report_profile": {
      "enum": [
        "EXECUTIVE_PERSONAL_REPORT",
        "STANDARD_PERSONAL_REPORT",
        "FULL_CRITICAL_REPORT",
        "TECHNICAL_ATLAS",
        "ESOTERIC_KABBALISTIC_REPORT"
      ]
    },
    "chiron_process": {
      "type": "object",
      "required": ["aspect_policy", "aspect_policy_ref"],
      "properties": {
        "complex_id": {"type": "string", "minLength": 1},
        "aspect_policy": {"$ref": "aspect-policy.schema.json"},
        "aspect_policy_ref": {"type": "string", "minLength": 1},
        "temporal_signals": {"type": "array", "items": {"type": "object"}},
        "temporal_sequence": {"type": ["object", "null"]},
        "documentary_evidence": {"type": "array", "items": {"type": "object"}},
        "counterevidence": {"type": "array", "items": {"type": "object"}},
        "technique_search": {
          "type": "object",
          "required": ["techniques_tested", "techniques_matched", "preregistered_techniques", "exploratory_techniques", "multiple_testing_context"],
          "properties": {
            "techniques_tested": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "techniques_matched": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "preregistered_techniques": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "exploratory_techniques": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "multiple_testing_context": {"type": "string", "minLength": 1},
            "selection_after_observation": {"type": ["boolean", "null"]},
            "universe_complete": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
