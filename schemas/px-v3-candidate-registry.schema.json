{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/px-v3-candidate-registry.schema.json",
  "title": "ALMAS · Registro de candidatos PX v3",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "policy_id",
    "status",
    "records",
    "scoring_enabled",
    "weighting_enabled",
    "ontology_enabled",
    "validated_candidate_ids"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "registry_id": {"const": "ALMAS_PX_V3_CANDIDATES"},
    "policy_id": {"const": "ALMAS_PX_V3_CANDIDATE_FREEZE_V1"},
    "status": {
      "enum": [
        "EMPTY_FROZEN_REGISTRY",
        "CANDIDATES_PRESENT"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "status",
          "target",
          "descriptor_ids",
          "formula_ref",
          "expected_direction",
          "development_case_refs",
          "s2_refs",
          "s3_refs",
          "ablation_refs",
          "negative_control_refs",
          "falsification_criteria",
          "holdout_refs",
          "formula_frozen_before_holdout",
          "holdout_fitted_thresholds",
          "scoring_enabled",
          "ontology_enabled"
        ],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["DRAFT", "FROZEN_FOR_VALIDATION", "REJECTED"]
          },
          "target": {"const": "PX"},
          "descriptor_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "formula_ref": {"type": "string", "minLength": 1},
          "expected_direction": {
            "enum": ["HIGHER_IS_MORE_SPECIFIC", "LOWER_IS_MORE_SPECIFIC", "COMPOSITE_RULE"]
          },
          "development_case_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "s2_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "s3_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "ablation_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "negative_control_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "falsification_criteria": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "holdout_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "formula_frozen_before_holdout": {"type": "boolean"},
          "holdout_fitted_thresholds": {"type": "boolean"},
          "scoring_enabled": {"const": false},
          "ontology_enabled": {"const": false},
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "scoring_enabled": {"const": false},
    "weighting_enabled": {"const": false},
    "ontology_enabled": {"const": false},
    "validated_candidate_ids": {
      "type": "array",
      "maxItems": 0
    }
  },
  "additionalProperties": false
}