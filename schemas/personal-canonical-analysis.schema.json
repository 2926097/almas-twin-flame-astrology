{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/personal-canonical-analysis.schema.json",
  "title": "ALMAS · Análisis canónico personal",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_type",
    "subject",
    "data_quality",
    "natal",
    "counterevidence",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "analysis_type": {"const": "PERSONAL_NATAL"},
    "subject": {
      "type": "object",
      "required": ["subject_id"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "display_name": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "data_quality": {
      "type": "object",
      "required": ["birth_time_quality", "timed"],
      "properties": {
        "birth_time_quality": {"enum": ["A", "B", "C", "D"]},
        "timed": {"type": "boolean"},
        "birth_time_source_class": {
          "enum": ["DOCUMENTARY", "REPORTED", "RECTIFIED", "UNKNOWN", null]
        }
      },
      "additionalProperties": true
    },
    "natal": {
      "allOf": [
        {"$ref": "natal-chart.schema.json"},
        {
          "type": "object",
          "required": ["backend_provenance"]
        }
      ]
    },
    "structural_layers": {"type": "object"},
    "secondary_layers": {"type": "object"},
    "temporal": {"type": "object"},
    "doctrine": {
      "type": "array",
      "items": {"type": "object"}
    },
    "hypotheses": {
      "type": "array",
      "items": {"type": "object"}
    },
    "counterevidence": {
      "type": "array",
      "items": {"type": "object"}
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "source_trace": {
      "type": "array",
      "items": {"type": "object"}
    },
    "personal_temporal_complexes": {
      "type": "array",
      "description": "Extensión opcional y aditiva; ausente en canonical personales 1.22.0.",
      "items": {"$ref": "chiron-process-output.schema.json"}
    }
  },
  "additionalProperties": false
}
