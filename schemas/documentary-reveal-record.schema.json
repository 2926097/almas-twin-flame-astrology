{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/documentary-reveal-record.schema.json",
  "title": "ALMAS · Registro de revelado documental",
  "type": "object",
  "required": [
    "schema_version", "policy_id", "policy_status", "epistemic_class",
    "validation_id", "candidate_id", "formula_ref", "cohort_id",
    "documentary_reveal_ref", "documentary_source_refs",
    "documentary_source_count", "blinding_audit_ref", "leakage_audit_ref",
    "continuity_certificate_sha256",
    "holdout_distribution_fingerprint_sha256",
    "pre_reveal_structural_output_sha256",
    "post_reveal_structural_output_sha256",
    "structural_output_invariant", "identity_blinding_state",
    "identity_risk_refs", "forbidden_field_hits", "label_leakage_count",
    "narrative_leakage_count", "case_fitting_count",
    "post_holdout_rule_change_count", "private_payloads_exposed",
    "promotion_decision", "automatic_registry_mutation",
    "scoring_activation", "weighting_activation", "ontology_activation",
    "l3_validation", "metaphysical_probability"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"const": "ALMAS_VALIDATION_CLOSURE_RELEASE_AUDIT_V1"},
    "policy_status": {"type": "string"},
    "epistemic_class": {"const": "E_PROJECT_POLICY"},
    "validation_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "formula_ref": {"type": "string", "minLength": 1},
    "cohort_id": {"type": "string", "minLength": 1},
    "documentary_reveal_ref": {"type": "string", "minLength": 1},
    "documentary_source_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "documentary_source_count": {"type": "integer", "minimum": 1},
    "blinding_audit_ref": {"type": "string", "minLength": 1},
    "leakage_audit_ref": {"type": "string", "minLength": 1},
    "continuity_certificate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "holdout_distribution_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pre_reveal_structural_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "post_reveal_structural_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "structural_output_invariant": {"const": true},
    "identity_blinding_state": {"enum": ["BLINDED", "UNAVOIDABLE_PUBLIC"]},
    "identity_risk_refs": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_field_hits": {"const": 0},
    "label_leakage_count": {"const": 0},
    "narrative_leakage_count": {"const": 0},
    "case_fitting_count": {"const": 0},
    "post_holdout_rule_change_count": {"const": 0},
    "private_payloads_exposed": {"const": false},
    "promotion_decision": {"const": "FORBIDDEN"},
    "automatic_registry_mutation": {"const": false},
    "scoring_activation": {"const": false},
    "weighting_activation": {"const": false},
    "ontology_activation": {"const": false},
    "l3_validation": {"const": false},
    "metaphysical_probability": {"const": false}
  },
  "additionalProperties": false
}
