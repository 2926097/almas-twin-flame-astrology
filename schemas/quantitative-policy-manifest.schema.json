{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/quantitative-policy-manifest.schema.json",
  "title": "ALMAS · Manifiesto de políticas cuantitativas",
  "type": "object",
  "required": [
    "manifest_version",
    "manifest_id",
    "almas_public_version",
    "baseline_release",
    "status",
    "epistemic_class",
    "purpose",
    "contracts",
    "invariants"
  ],
  "properties": {
    "manifest_version": {"const": "1.0.0"},
    "manifest_id": {"const": "ALMAS_QUANTITATIVE_POLICY_MANIFEST_V2"},
    "almas_public_version": {"const": "1.26.0"},
    "baseline_release": {"const": "1.21.0"},
    "status": {"const": "FROZEN_NORMATIVE"},
    "epistemic_class": {"const": "E_PROJECT_POLICY"},
    "purpose": {"type": "string", "minLength": 1},
    "contracts": {
      "type": "object",
      "required": [
        "root_motif_attribution",
        "robustness_dependency_grouping",
        "autonomous_counterevidence"
      ],
      "additionalProperties": false,
      "properties": {
        "root_motif_attribution": {"$ref": "#/$defs/contract"},
        "robustness_dependency_grouping": {"$ref": "#/$defs/contract"},
        "autonomous_counterevidence": {"$ref": "#/$defs/contract"}
      }
    },
    "invariants": {
      "type": "object",
      "required": [
        "root_motif_double_counting_as_players_forbidden",
        "motifs_recomputed_inside_shapley_coalitions",
        "correlated_robustness_components_grouped_before_geometric_mean",
        "autonomous_ice_requires_explicit_counterevidence_completeness",
        "same_contradiction_key_cannot_multiply_across_dependency_families",
        "essential_contradiction_gate_remains_separate",
        "missingness_never_becomes_zero_without_explicit_complete_assessment",
        "px_v3_activation_requires_external_validation",
        "metaphysical_probability_forbidden",
        "case_fitting_forbidden"
      ],
      "additionalProperties": false,
      "properties": {
        "root_motif_double_counting_as_players_forbidden": {"const": true},
        "motifs_recomputed_inside_shapley_coalitions": {"const": true},
        "correlated_robustness_components_grouped_before_geometric_mean": {"const": true},
        "autonomous_ice_requires_explicit_counterevidence_completeness": {"const": true},
        "same_contradiction_key_cannot_multiply_across_dependency_families": {"const": true},
        "essential_contradiction_gate_remains_separate": {"const": true},
        "missingness_never_becomes_zero_without_explicit_complete_assessment": {"const": true},
        "px_v3_activation_requires_external_validation": {"const": true},
        "metaphysical_probability_forbidden": {"const": true},
        "case_fitting_forbidden": {"const": true}
      }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "required": ["policy_id", "consumers"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "oneOf": [
        {"required": ["path"]},
        {"required": ["implementation"]}
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
