{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/personal-authored-report.schema.json",
  "title": "ALMAS · Informe astrológico personal redactado",
  "type": "object",
  "required": [
    "schema_version",
    "document_kind",
    "language",
    "report_profile",
    "canonical_fingerprint",
    "report_state",
    "interpretive_center",
    "technical_role",
    "metaphysical_scientific_validation_claimed",
    "personal_data_minimized",
    "canonical_values_mutated",
    "new_calculations_performed",
    "new_scores_created",
    "sections",
    "bibliography"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_kind": {"const": "ALMAS_PERSONAL_AUTHORED_REPORT"},
    "language": {"const": "es"},
    "report_profile": {
      "enum": [
        "EXECUTIVE_PERSONAL_REPORT",
        "STANDARD_PERSONAL_REPORT",
        "FULL_CRITICAL_REPORT",
        "TECHNICAL_ATLAS",
        "ESOTERIC_KABBALISTIC_REPORT"
      ]
    },
    "canonical_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "report_state": {"enum": ["READY", "PARTIAL"]},
    "interpretive_center": {
      "const": "PERSONAL_ASTROLOGY_AND_SOURCE_BASED_HERMENEUTICS"
    },
    "technical_role": {
      "const": "CALCULATION_TRACEABILITY_AND_QUALITY_CONTROL"
    },
    "metaphysical_scientific_validation_claimed": {"const": false},
    "personal_data_minimized": {"const": true},
    "canonical_values_mutated": {"const": false},
    "new_calculations_performed": {"const": false},
    "new_scores_created": {"const": false},
    "sections": {
      "type": "array",
      "minItems": 6,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "title",
          "authoring_state",
          "narrative",
          "canonical_paths_used",
          "epistemic_classes_used",
          "doctrinal_claim_refs",
          "source_refs",
          "limitations"
        ],
        "properties": {
          "section_id": {
            "enum": [
              "P01_SYNTHESIS",
              "P02_DATA_METHOD",
              "P03_NATAL_ARCHITECTURE",
              "P04_PERSONALITY_INTEGRATION",
              "P05_AFFECTIVE_RELATIONAL_STYLE",
              "P06_VOCATION_RESOURCES",
              "P07_EVOLUTIONARY_ESOTERIC",
              "P08_COMPLEMENTARY_LAYERS",
              "P09_TEMPORAL",
              "P10_COUNTEREVIDENCE",
              "P11_SOURCES_ATLAS"
            ]
          },
          "title": {"type": "string", "minLength": 1},
          "authoring_state": {
            "enum": ["AUTHORED", "OMITTED_NOT_AVAILABLE"]
          },
          "narrative": {"type": "string"},
          "canonical_paths_used": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "epistemic_classes_used": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "A_CALCULATED",
                "B_TECHNIQUE",
                "C_DOCTRINE",
                "D_CONTEMPORARY_USAGE",
                "E_PROJECT_HYPOTHESIS"
              ]
            }
          },
          "doctrinal_claim_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "bibliography": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "citation_label", "source_scope"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "citation_label": {"type": "string", "minLength": 1},
          "source_scope": {
            "enum": [
              "DOCTRINE",
              "TECHNIQUE",
              "ACADEMIC",
              "CONTEMPORARY",
              "OTHER_VERIFIED"
            ]
          },
          "author": {"type": ["string", "null"]},
          "work": {"type": ["string", "null"]},
          "tradition": {"type": ["string", "null"]},
          "locator": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"]},
          "verification_anchor": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
