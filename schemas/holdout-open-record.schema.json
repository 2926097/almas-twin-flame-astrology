{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/holdout-open-record.schema.json",
  "title": "ALMAS · Holdout Open Record",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "policy_status",
    "epistemic_class",
    "validation_id",
    "preregistration_ref",
    "preregistration_sha256",
    "runtime_almas_version",
    "runtime_commit_sha",
    "candidate_id",
    "formula_ref",
    "cohort_header",
    "holdout_opened",
    "holdout_evaluation_permitted",
    "holdout_evaluated",
    "promotion_permitted",
    "automatic_registry_mutation",
    "scoring_activation",
    "weighting_activation",
    "ontology_activation",
    "l3_validation",
    "metaphysical_probability"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"const": "ALMAS_HOLDOUT_OPEN_GATE_V1"},
    "policy_status": {"type": "string"},
    "epistemic_class": {"const": "E_PROJECT_POLICY"},
    "validation_id": {"type": ["string", "null"]},
    "preregistration_ref": {"type": ["string", "null"]},
    "preregistration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_almas_version": {"type": "string", "minLength": 1},
    "runtime_commit_sha": {"type": "string", "minLength": 7},
    "candidate_id": {"type": ["string", "null"]},
    "formula_ref": {"type": ["string", "null"]},
    "cohort_header": {
      "type": "object",
      "required": [
        "cohort_id",
        "null_model",
        "feature_set_ref",
        "orb_policy_ref",
        "pairing_rule_ref",
        "inclusion_rule_ref",
        "sample_count"
      ],
      "properties": {
        "cohort_id": {"type": ["string", "null"]},
        "null_model": {
          "enum": ["PAIR_SHUFFLE", "MATCHED_AGE", "MATCHED_AGE_CLOCK"]
        },
        "feature_set_ref": {"type": ["string", "null"]},
        "orb_policy_ref": {"type": ["string", "null"]},
        "pairing_rule_ref": {"type": ["string", "null"]},
        "inclusion_rule_ref": {"type": ["string", "null"]},
        "sample_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "holdout_opened": {"const": true},
    "holdout_evaluation_permitted": {"const": true},
    "holdout_evaluated": {"const": false},
    "promotion_permitted": {"const": false},
    "automatic_registry_mutation": {"const": false},
    "scoring_activation": {"const": false},
    "weighting_activation": {"const": false},
    "ontology_activation": {"const": false},
    "l3_validation": {"const": false},
    "metaphysical_probability": {"const": false}
  },
  "additionalProperties": false
}