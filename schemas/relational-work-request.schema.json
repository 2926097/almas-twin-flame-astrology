{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/relational-work-request.schema.json",
  "title": "ALMAS · Envolvente relacional del panel",
  "type": "object",
  "required": [
    "request"
  ],
  "properties": {
    "case_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "research_question": {
      "type": [
        "string",
        "null"
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "format",
        "public_version",
        "type",
        "analysis_profile",
        "subjects",
        "execution_state"
      ],
      "properties": {
        "format": {
          "const": "ALMAS_WORK_REQUEST"
        },
        "public_version": {
          "enum": [
            "1.25.0",
            "1.26.0"
          ]
        },
        "type": {
          "const": "RELATIONAL"
        },
        "analysis_profile": {
          "enum": [
            "FULL_MULTIDISCIPLINARY",
            "FULL_ASTROLOGY",
            "TEMPORAL",
            "SOUL_CONTRACT"
          ]
        },
        "analysis_policy_profile": {
          "enum": [
            "ALMAS_RELATIONAL_STRICT_RESEARCH_V1",
            null
          ]
        },
        "subjects": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "birth_date",
              "latitude",
              "longitude",
              "time_reliability"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "display_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "birth_date": {
                "type": "string",
                "format": "date"
              },
              "birth_time": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timezone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "place": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "time_reliability": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              "birth_time_source_class": {
                "enum": [
                  "DOCUMENTARY",
                  "REPORTED",
                  "RECTIFIED",
                  "UNKNOWN",
                  null
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "analysis_policies": {
          "type": "object",
          "properties": {
            "aspect_policy": {
              "$ref": "aspect-policy.schema.json"
            },
            "draconic_aspect_policy": {
              "$ref": "aspect-policy.schema.json"
            },
            "declination_policy": {
              "type": "object"
            },
            "antiscia_policy": {
              "type": "object"
            },
            "relationship_chart_consonance_policy": {
              "type": "object"
            },
            "composite_policy": {
              "type": "object"
            },
            "davison_policy": {
              "type": "object"
            },
            "draconic_policy": {
              "type": "object"
            },
            "rulership_policy": {
              "type": "object"
            },
            "rulership_policy_id": {
              "type": "string",
              "minLength": 1
            },
            "decan_rulership_policy": {
              "$ref": "decan-rulership-policy.schema.json"
            },
            "lot_policy": {
              "type": "object"
            },
            "secondary_symbolic_policy": {
              "type": "object"
            },
            "maximum_definition_context": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "execution_state": {
          "const": "REQUEST_ONLY"
        },
        "research_question": {
          "type": [
            "string",
            "null"
          ]
        },
        "situation_location": {
          "type": [
            "object",
            "null"
          ]
        },
        "requirements": {
          "type": [
            "string",
            "null"
          ]
        },
        "atacires_requests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "subject_id",
              "settings"
            ],
            "properties": {
              "subject_id": {
                "type": "string",
                "minLength": 1
              },
              "settings": {
                "type": "object",
                "required": [
                  "start_utc",
                  "end_utc",
                  "cycle_years"
                ],
                "properties": {
                  "start_utc": {
                    "type": "string",
                    "minLength": 1
                  },
                  "end_utc": {
                    "type": "string",
                    "minLength": 1
                  },
                  "output_timezone": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cycle_years": {
                    "type": "number",
                    "minimum": 0.0001,
                    "maximum": 10000
                  },
                  "year_days": {
                    "type": "number",
                    "minimum": 360,
                    "maximum": 366
                  },
                  "orb_deg": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 179.999999
                  },
                  "direction": {
                    "enum": [
                      "direct",
                      "converse"
                    ]
                  },
                  "include_self": {
                    "type": "boolean"
                  },
                  "aspects_deg": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 180
                    }
                  },
                  "promissors": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]*$"
                    }
                  },
                  "significators": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]*$"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "situation": {
      "type": [
        "object",
        "null"
      ]
    },
    "chronology": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
