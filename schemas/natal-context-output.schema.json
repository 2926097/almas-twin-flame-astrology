{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/natal-context-output.schema.json",
  "title": "ALMAS · Salida de contexto natal",
  "type": "object",
  "required": [
    "subjects",
    "cross_house_placements"
  ],
  "properties": {
    "subjects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "timed",
          "point_signs",
          "nodes",
          "angles",
          "house_cusps",
          "house_placements",
          "rulerships"
        ],
        "properties": {
          "timed": {
            "type": "boolean"
          },
          "point_signs": {
            "type": "object"
          },
          "nodes": {
            "type": "object"
          },
          "angles": {
            "type": "object"
          },
          "house_cusps": {
            "type": "object"
          },
          "house_placements": {
            "type": "object"
          },
          "rulerships": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "cross_house_placements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "source_subject",
          "target_subject",
          "placements"
        ],
        "properties": {
          "source_subject": {
            "type": "string",
            "minLength": 1
          },
          "target_subject": {
            "type": "string",
            "minLength": 1
          },
          "placements": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "house",
                "longitude"
              ],
              "properties": {
                "house": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "longitude": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 360
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
