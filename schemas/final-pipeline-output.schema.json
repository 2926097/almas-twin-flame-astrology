{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/almas/final-pipeline-output.schema.json",
  "title":"ALMAS Final Pipeline Outputs",
  "type":"object",
  "properties":{
    "doctrine_hermeneutics":{
      "type":"object",
      "required":[
        "claims","claim_count","source_registry_checked","unresolved_sources",
        "doctrine_adds_structural_score","epistemic_separation_enforced"
      ],
      "properties":{
        "doctrine_adds_structural_score":{"const":false},
        "epistemic_separation_enforced":{"const":true}
      },
      "additionalProperties":true
    },
    "viability_reciprocity":{
      "type":"object",
      "required":[
        "real_viability","reciprocity",
        "astrology_used_as_real_world_fact","future_decisions_inferred"
      ],
      "properties":{
        "astrology_used_as_real_world_fact":{"const":false},
        "future_decisions_inferred":{"const":false}
      },
      "additionalProperties":true
    },
    "report_gate":{
      "type":"object",
      "required":[
        "state","missing_fields","failed_modules","reportable",
        "canonical_values_mutated"
      ],
      "properties":{
        "canonical_values_mutated":{"const":false}
      },
      "additionalProperties":true
    },
    "report_document_model":{
      "type":"object",
      "required":[
        "model_version","sections","canonical_source",
        "canonical_values_mutated","rendered_document_created"
      ],
      "properties":{
        "canonical_source":{"const":"canonical_analysis"},
        "canonical_values_mutated":{"const":false},
        "rendered_document_created":{"const":false}
      },
      "additionalProperties":true
    }
  },
  "additionalProperties":false
}
