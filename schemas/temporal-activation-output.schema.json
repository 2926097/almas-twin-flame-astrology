{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/temporal-activation-output.schema.json",
  "title": "ALMAS · Salida de activación temporal",
  "type": "object",
  "required": [
    "signals",
    "selected_independent_signals",
    "suppressed",
    "root_activation_summary",
    "iat_eligible_signal_ids",
    "iat",
    "iat_state",
    "iat_components",
    "iat_policy",
    "aggregation_weights_applied",
    "structural_score_modified",
    "structural_roots_created",
    "real_world_event_prediction_made"
  ],
  "properties": {
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signal_id",
          "layer",
          "target",
          "iat_scope",
          "technique",
          "dependency_cluster",
          "root_id",
          "anchored",
          "clause_id",
          "structural_family",
          "temporal_family",
          "activation_class",
          "k",
          "strength",
          "effective_strength",
          "exactitude_orb",
          "preregistered_window_rule",
          "preregistered",
          "window_status",
          "date_or_period",
          "event_refs",
          "trigger_context",
          "traceability_complete",
          "missing_traceability",
          "iat_eligible",
          "creates_structural_root",
          "predicts_real_world_event"
        ],
        "properties": {
          "signal_id": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "const": "TEMPORAL"
          },
          "target": {
            "enum": [
              "RELATION",
              "ACTOR_A",
              "ACTOR_B",
              "CROSS",
              "UNSPECIFIED"
            ]
          },
          "iat_scope": {
            "enum": [
              "IAT_REL",
              "IAT_A",
              "IAT_B",
              "IAT_CROSS",
              null
            ]
          },
          "technique": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependency_cluster": {
            "type": "string",
            "minLength": 1
          },
          "root_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "anchored": {
            "type": "boolean"
          },
          "clause_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "structural_family": {
            "type": [
              "string",
              "null"
            ]
          },
          "temporal_family": {
            "enum": [
              "TPROG",
              "TDIR",
              "TTRANSIT",
              "TECLIPSE",
              "TREL",
              "TATACIR"
            ]
          },
          "activation_class": {
            "enum": [
              "DIRECT_REPETITION",
              "RELATIONAL_ROOT_ACTIVATION",
              "ENDPOINT_ACTIVATION",
              "UNANCHORED"
            ]
          },
          "k": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "effective_strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "exactitude_orb": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "preregistered_window_rule": {
            "type": [
              "string",
              "null"
            ]
          },
          "preregistered": {
            "type": "boolean"
          },
          "window_status": {
            "enum": [
              "RETROSPECTIVE_CONFIRMED",
              "RETROSPECTIVE_UNCONFIRMED",
              "CURRENT_ACTIVE",
              "PROSPECTIVE_ACTIVATION",
              "EXPLORATORY",
              "UNANCHORED"
            ]
          },
          "date_or_period": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "traceability_complete": {
            "type": "boolean"
          },
          "missing_traceability": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "iat_eligible": {
            "type": "boolean"
          },
          "creates_structural_root": {
            "const": false
          },
          "predicts_real_world_event": {
            "const": false
          },
          "trigger_context": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "trigger_point",
                  "target_point",
                  "relation"
                ],
                "properties": {
                  "trigger_point": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target_point": {
                    "type": "string",
                    "minLength": 1
                  },
                  "relation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_layer": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "target_layer": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "source_subject": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "target_subject": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "orb": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "technique_variant": {
            "type": [
              "string",
              "null"
            ]
          },
          "technique_variant_source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependency_group": {
            "type": "string",
            "minLength": 1
          },
          "exact_datetime": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "orb": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "applying_or_separating": {
            "enum": [
              "APPLYING",
              "SEPARATING",
              "EXACT_PERFECTION",
              "UNKNOWN",
              null
            ]
          },
          "pass_number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "station_context": {
            "type": [
              "string",
              "null"
            ]
          },
          "motion_state": {
            "enum": [
              "DIRECT",
              "RETROGRADE",
              "STATIONARY",
              "OSCILLATING",
              "UNKNOWN",
              null
            ]
          },
          "source_point": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_point": {
            "type": [
              "string",
              "null"
            ]
          },
          "relation": {
            "type": [
              "string",
              "null"
            ]
          },
          "node_variant": {
            "enum": [
              "TRUE",
              "MEAN",
              null
            ]
          },
          "nodal_axis_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "selected_independent_signals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "suppressed": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "root_activation_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "root_id",
          "independent_temporal_families",
          "independent_family_count",
          "selected_signal_ids",
          "recurring_across_independent_families"
        ],
        "properties": {
          "root_id": {
            "type": "string"
          },
          "independent_temporal_families": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "independent_family_count": {
            "type": "integer",
            "minimum": 1
          },
          "selected_signal_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "recurring_across_independent_families": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "iat_eligible_signal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "iat": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "iat_state": {
      "enum": [
        "CALCULATED",
        "NOT_CALCULATED"
      ]
    },
    "iat_components": {
      "type": "object",
      "required": [
        "IAT_REL",
        "IAT_A",
        "IAT_B",
        "IAT_CROSS"
      ],
      "properties": {
        "IAT_REL": {
          "$ref": "#/$defs/unscored_iat_component"
        },
        "IAT_A": {
          "$ref": "#/$defs/unscored_iat_component"
        },
        "IAT_B": {
          "$ref": "#/$defs/unscored_iat_component"
        },
        "IAT_CROSS": {
          "$ref": "#/$defs/unscored_iat_component"
        }
      },
      "additionalProperties": false
    },
    "iat_policy": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "preregistration_ref": {
          "type": "string",
          "minLength": 1
        },
        "window_scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "formula": {
          "const": "WEIGHTED_MEAN_EFFECTIVE_STRENGTH"
        },
        "family_weights": {
          "type": "object"
        },
        "root_weights": {
          "type": "object"
        },
        "applied_signal_weights": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "aggregation_weights_applied": {
      "type": "boolean"
    },
    "structural_score_modified": {
      "const": false
    },
    "structural_roots_created": {
      "const": false
    },
    "real_world_event_prediction_made": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "iat_state": {
            "const": "CALCULATED"
          }
        }
      },
      "then": {
        "properties": {
          "iat": {
            "type": "number"
          },
          "iat_policy": {
            "type": "object"
          },
          "aggregation_weights_applied": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "iat_state": {
            "const": "NOT_CALCULATED"
          }
        }
      },
      "then": {
        "properties": {
          "iat": {
            "type": "null"
          },
          "aggregation_weights_applied": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "unscored_iat_component": {
      "type": "object",
      "required": [
        "status",
        "value",
        "signal_ids",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "NOT_EVALUABLE"
        },
        "value": {
          "type": "null"
        },
        "signal_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
