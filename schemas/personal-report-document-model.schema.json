{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/personal-report-document-model.schema.json",
  "title": "ALMAS · Modelo documental de informe personal",
  "type": "object",
  "required": [
    "model_version",
    "document_kind",
    "language",
    "analysis_type",
    "report_profile",
    "report_state",
    "canonical_source",
    "canonical_fingerprint",
    "canonical_fingerprint_verified",
    "reference_domains",
    "sections",
    "publication_contract",
    "canonical_values_embedded",
    "canonical_values_mutated",
    "prose_generated",
    "docx_created",
    "pdf_created",
    "pdf_preflight_performed"
  ],
  "properties": {
    "model_version": {"const": "1.0.0"},
    "document_kind": {"const": "ALMAS_PERSONAL_REPORT_MODEL"},
    "language": {"const": "es"},
    "analysis_type": {"const": "PERSONAL_NATAL"},
    "report_profile": {
      "enum": [
        "EXECUTIVE_PERSONAL_REPORT",
        "STANDARD_PERSONAL_REPORT",
        "FULL_CRITICAL_REPORT",
        "TECHNICAL_ATLAS",
        "ESOTERIC_KABBALISTIC_REPORT"
      ]
    },
    "report_state": {"enum": ["READY", "PARTIAL"]},
    "degradation_reasons": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "canonical_source": {"const": "personal_canonical_analysis"},
    "canonical_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonical_fingerprint_verified": {"const": true},
    "reference_domains": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "sections": {
      "type": "array",
      "minItems": 6,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "order",
          "title",
          "section_state",
          "required_paths",
          "optional_paths",
          "available_paths",
          "missing_required_paths",
          "missing_optional_paths",
          "epistemic_classes_allowed",
          "canonical_values_embedded",
          "narrative_generated"
        ],
        "properties": {
          "section_id": {
            "enum": [
              "P01_SYNTHESIS",
              "P02_DATA_METHOD",
              "P03_NATAL_ARCHITECTURE",
              "P04_PERSONALITY_INTEGRATION",
              "P05_AFFECTIVE_RELATIONAL_STYLE",
              "P06_VOCATION_RESOURCES",
              "P07_EVOLUTIONARY_ESOTERIC",
              "P08_COMPLEMENTARY_LAYERS",
              "P09_TEMPORAL",
              "P10_COUNTEREVIDENCE",
              "P11_SOURCES_ATLAS"
            ]
          },
          "order": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "section_state": {"enum": ["READY", "PARTIAL", "NOT_AVAILABLE"]},
          "required_paths": {"type": "array", "items": {"type": "string"}},
          "optional_paths": {"type": "array", "items": {"type": "string"}},
          "available_paths": {"type": "array", "items": {"type": "string"}},
          "missing_required_paths": {"type": "array", "items": {"type": "string"}},
          "missing_optional_paths": {"type": "array", "items": {"type": "string"}},
          "epistemic_classes_allowed": {
            "type": "array",
            "items": {
              "enum": [
                "A_CALCULATED",
                "B_TECHNIQUE",
                "C_DOCTRINE",
                "D_CONTEMPORARY_USAGE",
                "E_PROJECT_HYPOTHESIS"
              ]
            }
          },
          "canonical_values_embedded": {"const": false},
          "narrative_generated": {"const": false}
        },
        "additionalProperties": false
      }
    },
    "publication_contract": {
      "type": "object",
      "required": [
        "profile_family",
        "reuse_existing_publication_infrastructure",
        "adapter_status"
      ],
      "properties": {
        "profile_family": {"const": "ALMAS_B5"},
        "reuse_existing_publication_infrastructure": {"const": true},
        "adapter_status": {"enum": ["PENDING_ADAPTER", "READY"]}
      },
      "additionalProperties": false
    },
    "canonical_values_embedded": {"const": false},
    "canonical_values_mutated": {"const": false},
    "prose_generated": {"const": false},
    "docx_created": {"const": false},
    "pdf_created": {"const": false},
    "pdf_preflight_performed": {"const": false}
  },
  "additionalProperties": false
}
