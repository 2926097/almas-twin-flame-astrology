{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/raw-input.schema.json",
  "title": "ALMAS · Entrada relacional bruta",
  "type": "object",
  "required": [
    "subjects"
  ],
  "properties": {
    "subjects": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "birth_date"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "birth_date": {
            "type": "string",
            "format": "date"
          },
          "birth_time": {
            "type": [
              "string",
              "null"
            ]
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ]
          },
          "place": {
            "type": [
              "string",
              "null"
            ]
          },
          "latitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "longitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "time_reliability": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              null
            ]
          }
        }
      }
    },
    "aspect_policy": {
      "$ref": "aspect-policy.schema.json"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "mode": {
      "enum": [
        "FULL",
        "TARGETED",
        "TEMPORAL",
        "REPORT"
      ]
    },
    "analysis_profile": {
      "enum": [
        "FULL_MULTIDISCIPLINARY",
        "FULL_ASTROLOGY",
        "TEMPORAL",
        "SOUL_CONTRACT",
        null
      ]
    },
    "counterevidence_assessment_complete": {
      "type": "boolean",
      "default": false
    },
    "ice_by_model": {
      "type": "object",
      "required": [
        "AF",
        "KA",
        "AG",
        "LG"
      ],
      "properties": {
        "AF": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "KA": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "AG": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "LG": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "counterevidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "models",
          "contradiction_key",
          "dependency_family"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "EXPLICIT_CONTRADICTION",
              "STRUCTURAL_INCOMPATIBILITY"
            ]
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "AF",
                "KA",
                "AG",
                "LG"
              ]
            }
          },
          "contradiction_key": {
            "type": "string",
            "minLength": 1
          },
          "dependency_family": {
            "type": "string",
            "minLength": 1
          },
          "essential": {
            "type": "boolean",
            "default": false
          },
          "severity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "counterevidence_assessment_complete": {
            "const": true
          }
        },
        "required": [
          "counterevidence_assessment_complete"
        ]
      },
      "then": {
        "properties": {
          "counterevidence_items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "models",
                "contradiction_key",
                "dependency_family",
                "severity"
              ]
            }
          }
        }
      }
    }
  ]
}
