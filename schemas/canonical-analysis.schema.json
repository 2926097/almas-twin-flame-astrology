{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/canonical-analysis.schema.json",
  "title": "ALMAS · Análisis canónico",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_mode",
    "analysis_profile",
    "profile_policy_id",
    "astronomy_backend",
    "evidence",
    "models",
    "indices",
    "pairwise_idd",
    "coverage",
    "robustness",
    "counterevidence",
    "counterevidence_state",
    "ontology",
    "doctrine",
    "temporal",
    "limitations",
    "assembly"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "analysis_mode": {
      "enum": [
        "FULL",
        "TEMPORAL"
      ]
    },
    "analysis_profile": {
      "enum": [
        "FULL_MULTIDISCIPLINARY",
        "FULL_ASTROLOGY",
        "TEMPORAL",
        "SOUL_CONTRACT"
      ]
    },
    "profile_policy_id": {
      "const": "ALMAS_ANALYSIS_PROFILES_V1"
    },
    "natal_context": {
      "$ref": "natal-context-output.schema.json"
    },
    "relationship_field": {
      "$ref": "relationship-chart-consonance.schema.json#/properties/field_context"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "source_module",
          "root_id",
          "root_key",
          "strength",
          "strength_state",
          "core_eligible",
          "dependency_families",
          "independent_family_count",
          "point_ids",
          "relation_ids",
          "concrete_contacts",
          "max_exactness",
          "house_overlays"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^ROOT:.+"
          },
          "source_module": {
            "const": "M17"
          },
          "root_id": {
            "type": "string",
            "minLength": 1
          },
          "root_key": {
            "type": "string",
            "minLength": 1
          },
          "strength": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "strength_state": {
            "enum": [
              "CALCULATED_CORE",
              "CALCULATED_SUPPORT_ONLY",
              "NOT_EVALUABLE"
            ]
          },
          "core_eligible": {
            "type": "boolean"
          },
          "dependency_families": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "independent_family_count": {
            "type": "integer",
            "minimum": 1
          },
          "point_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "relation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "max_exactness": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "house_overlays": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "source_subject",
                "point_id",
                "target_subject",
                "house"
              ],
              "properties": {
                "source_subject": {
                  "type": "string",
                  "minLength": 1
                },
                "point_id": {
                  "type": "string",
                  "minLength": 1
                },
                "target_subject": {
                  "type": "string",
                  "minLength": 1
                },
                "house": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                }
              },
              "additionalProperties": false
            }
          },
          "concrete_contacts": {
            "$ref": "independent-roots.schema.json#/properties/roots/items/properties/concrete_contacts"
          }
        },
        "additionalProperties": false
      }
    },
    "models": {
      "type": "object",
      "required": [
        "AF",
        "KA",
        "AG",
        "LG"
      ],
      "properties": {
        "AF": {
          "$ref": "#/$defs/model_result"
        },
        "KA": {
          "$ref": "#/$defs/model_result"
        },
        "AG": {
          "$ref": "#/$defs/model_result"
        },
        "LG": {
          "$ref": "#/$defs/model_result"
        }
      },
      "additionalProperties": false
    },
    "indices": {
      "type": "object",
      "required": [
        "IDD",
        "IAT",
        "ICC",
        "IRC",
        "ICE"
      ],
      "properties": {
        "IDD": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "IAT": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "ICC": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "IRC": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "ICE": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "ICC",
        "domains",
        "formula",
        "policy_id"
      ],
      "properties": {
        "ICC": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "domains": {
          "type": "object",
          "required": [
            "BASE_NATAL",
            "SYNASTRY_NODES",
            "ANGLES_HOUSES",
            "SYMMETRIES",
            "RELATIONSHIP_CHARTS",
            "DRACONIC",
            "LOTS_SECONDARY"
          ],
          "properties": {
            "BASE_NATAL": {
              "type": "object",
              "required": [
                "q"
              ],
              "properties": {
                "q": {
                  "enum": [
                    0,
                    0.5,
                    1
                  ]
                }
              },
              "additionalProperties": false
            },
            "SYNASTRY_NODES": {
              "type": "object",
              "required": [
                "q"
              ],
              "properties": {
                "q": {
                  "enum": [
                    0,
                    0.5,
                    1
                  ]
                }
              },
              "additionalProperties": false
            },
            "ANGLES_HOUSES": {
              "type": "object",
              "required": [
                "q"
              ],
              "properties": {
                "q": {
                  "enum": [
                    0,
                    0.5,
                    1
                  ]
                }
              },
              "additionalProperties": false
            },
            "SYMMETRIES": {
              "type": "object",
              "required": [
                "q"
              ],
              "properties": {
                "q": {
                  "enum": [
                    0,
                    0.5,
                    1
                  ]
                }
              },
              "additionalProperties": false
            },
            "RELATIONSHIP_CHARTS": {
              "type": "object",
              "required": [
                "q"
              ],
              "properties": {
                "q": {
                  "enum": [
                    0,
                    0.5,
                    1
                  ]
                }
              },
              "additionalProperties": false
            },
            "DRACONIC": {
              "type": "object",
              "required": [
                "q"
              ],
              "properties": {
                "q": {
                  "enum": [
                    0,
                    0.5,
                    1
                  ]
                }
              },
              "additionalProperties": false
            },
            "LOTS_SECONDARY": {
              "type": "object",
              "required": [
                "q"
              ],
              "properties": {
                "q": {
                  "enum": [
                    0,
                    0.5,
                    1
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "formula": {
          "const": "100*sum(q_domain)/7"
        },
        "policy_id": {
          "const": "ALMAS_CANONICAL_ASSEMBLY_V2"
        }
      },
      "additionalProperties": false
    },
    "robustness": {
      "type": "object",
      "required": [
        "IRC",
        "R_min",
        "component_count",
        "components",
        "null_model_rarity_used_as_robustness",
        "timed_architecture_present",
        "birth_time_component_present"
      ],
      "properties": {
        "IRC": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "R_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "component_count": {
          "type": "integer",
          "minimum": 1
        },
        "group_count": {
          "$ref": "robustness-output.schema.json#/properties/group_count"
        },
        "dependency_groups": {
          "$ref": "robustness-output.schema.json#/properties/dependency_groups"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "robustness-output.schema.json#/properties/components/items"
          }
        },
        "null_model_rarity_used_as_robustness": {
          "const": false
        },
        "timed_architecture_present": {
          "type": "boolean"
        },
        "birth_time_component_present": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/counterevidence_item"
      }
    },
    "ontology": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    "doctrine": {
      "type": "array",
      "items": {
        "$ref": "doctrinal-claim.schema.json"
      }
    },
    "temporal": {
      "type": "object",
      "properties": {
        "activation": {
          "$ref": "temporal-activation-output.schema.json"
        },
        "events": {
          "$ref": "documentary-event-output.schema.json"
        }
      },
      "additionalProperties": false
    },
    "dynamic_phases": {
      "$ref": "dynamic-phase-state.schema.json"
    },
    "actor_states": {
      "type": "object",
      "required": [
        "actor_a",
        "actor_b"
      ],
      "properties": {
        "actor_a": {
          "$ref": "dynamic-phase-state.schema.json#/$defs/unassessed_phase"
        },
        "actor_b": {
          "$ref": "dynamic-phase-state.schema.json#/$defs/unassessed_phase"
        }
      },
      "additionalProperties": false
    },
    "phase_transitions": {
      "type": "array",
      "items": {
        "$ref": "phase-transition-evidence-matrix.schema.json"
      }
    },
    "doctrinal_sequences": {
      "type": "array",
      "items": {
        "$ref": "doctrinal-sequence-result.schema.json"
      }
    },
    "temporal_sequence_graph": {
      "$ref": "temporal-sequence-graph.schema.json"
    },
    "temporal_layers": {
      "type": "object",
      "required": [
        "IAT_REL",
        "IAT_A",
        "IAT_B",
        "IAT_CROSS"
      ],
      "properties": {
        "IAT_REL": {
          "$ref": "#/$defs/temporal_layer"
        },
        "IAT_A": {
          "$ref": "#/$defs/temporal_layer"
        },
        "IAT_B": {
          "$ref": "#/$defs/temporal_layer"
        },
        "IAT_CROSS": {
          "$ref": "#/$defs/temporal_layer"
        }
      },
      "additionalProperties": false
    },
    "root_recurrence": {
      "type": "object",
      "required": [
        "status",
        "units",
        "score_created"
      ],
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "COMPATIBLE",
            "INSUFFICIENT",
            "CONTRADICTED",
            "NOT_EVALUABLE"
          ]
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "score_created": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "causal_firewall": {
      "type": "object",
      "required": [
        "causal_status",
        "astrology_causes_behavior"
      ],
      "properties": {
        "causal_status": {
          "const": "UNESTABLISHED"
        },
        "astrology_causes_behavior": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "preregistered_predictions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "angular_robustness": {
      "$ref": "angular-robustness-output.schema.json"
    },
    "semantic_motifs": {
      "$ref": "semantic-motif-graph.schema.json"
    },
    "time_sensitivity": {
      "$ref": "time-sensitivity-output.schema.json"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ontological_discrimination": {
      "$ref": "ontological-discriminator-output.schema.json"
    },
    "pairwise_idd": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "idd",
          "band"
        ],
        "properties": {
          "idd": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "band": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "counterevidence_state": {
      "type": "object",
      "required": [
        "ice_evaluable",
        "ice_by_model",
        "essential_contradictions"
      ],
      "properties": {
        "ice_evaluable": {
          "type": "boolean"
        },
        "ice_by_model": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "AF",
                "KA",
                "AG",
                "LG"
              ],
              "properties": {
                "AF": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "KA": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "AG": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "LG": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "ice_source_state": {
          "enum": [
            "PRECOMPUTED",
            "AUTONOMOUS",
            "NOT_CALCULATED"
          ]
        },
        "counterevidence_complete": {
          "type": "boolean"
        },
        "ice_derivation": {
          "$ref": "counterevidence-output.schema.json#/$defs/iceDerivation"
        },
        "essential_contradictions": {
          "type": "object",
          "required": [
            "AF",
            "KA",
            "AG",
            "LG"
          ],
          "properties": {
            "AF": {
              "type": "boolean"
            },
            "KA": {
              "type": "boolean"
            },
            "AG": {
              "type": "boolean"
            },
            "LG": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "ice_evaluable": {
                "const": true
              }
            },
            "required": [
              "ice_evaluable"
            ]
          },
          "then": {
            "properties": {
              "ice_by_model": {
                "type": "object",
                "required": [
                  "AF",
                  "KA",
                  "AG",
                  "LG"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ice_evaluable": {
                "const": false
              }
            },
            "required": [
              "ice_evaluable"
            ]
          },
          "then": {
            "properties": {
              "ice_by_model": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "assembly": {
      "type": "object",
      "required": [
        "policy_id",
        "policy_status",
        "epistemic_class",
        "source",
        "analysis_profile",
        "recalculated_astrology",
        "recalculated_roots",
        "recalculated_pillars"
      ],
      "properties": {
        "policy_id": {
          "const": "ALMAS_CANONICAL_ASSEMBLY_V2"
        },
        "policy_status": {
          "const": "FROZEN_EXPERIMENTAL_BASELINE"
        },
        "epistemic_class": {
          "const": "E_PROJECT_POLICY"
        },
        "source": {
          "const": "M01_M29_CANONICAL_NAMESPACES"
        },
        "analysis_profile": {
          "type": "object",
          "required": [
            "profile_id",
            "analysis_mode",
            "required_modules",
            "optional_modules",
            "excluded_modules",
            "policy_id",
            "policy_status",
            "epistemic_class"
          ],
          "properties": {
            "profile_id": {
              "enum": [
                "FULL_MULTIDISCIPLINARY",
                "FULL_ASTROLOGY",
                "TEMPORAL",
                "SOUL_CONTRACT"
              ]
            },
            "analysis_mode": {
              "enum": [
                "FULL",
                "TEMPORAL"
              ]
            },
            "required_modules": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^M(?:0[1-9]|1[0-9]|2[0-9])$"
              }
            },
            "optional_modules": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^M(?:0[1-9]|1[0-9]|2[0-9])$"
              }
            },
            "excluded_modules": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^M(?:0[1-9]|1[0-9]|2[0-9])$"
              }
            },
            "policy_id": {
              "const": "ALMAS_ANALYSIS_PROFILES_V1"
            },
            "policy_status": {
              "const": "FROZEN_EXPERIMENTAL_BASELINE"
            },
            "epistemic_class": {
              "const": "E_PROJECT_POLICY"
            }
          },
          "additionalProperties": false
        },
        "recalculated_astrology": {
          "const": false
        },
        "recalculated_roots": {
          "const": false
        },
        "recalculated_pillars": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "null_models": {
      "$ref": "null-model-output.schema.json"
    },
    "astronomy_backend": {
      "type": "object",
      "required": [
        "state",
        "backend_id",
        "backend_version",
        "provenance_state",
        "provenance"
      ],
      "properties": {
        "state": {
          "enum": [
            "AVAILABLE",
            "NOT_AVAILABLE"
          ]
        },
        "backend_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "backend_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance_state": {
          "enum": [
            "DECLARED",
            "NOT_DECLARED",
            "NOT_AVAILABLE"
          ]
        },
        "provenance": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "NOT_AVAILABLE"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "backend_id": {
                "type": "null"
              },
              "backend_version": {
                "type": "null"
              },
              "provenance_state": {
                "const": "NOT_AVAILABLE"
              },
              "provenance": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance_state": {
                "const": "NOT_DECLARED"
              }
            },
            "required": [
              "provenance_state"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend_id": {
                "const": "MOIRA_JPL_SPK"
              }
            },
            "required": [
              "backend_id"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "AVAILABLE"
              },
              "backend_version": {
                "const": "6.8.2"
              },
              "provenance_state": {
                "const": "DECLARED"
              },
              "provenance": {
                "$ref": "astronomy-backend-provenance.schema.json"
              }
            }
          }
        }
      ]
    },
    "draconic_context": {
      "type": "object",
      "required": [
        "authoring_projection_only",
        "creates_additional_evidence"
      ],
      "properties": {
        "authoring_projection_only": {
          "const": true
        },
        "creates_additional_evidence": {
          "const": false
        },
        "individual": {
          "$ref": "draconic-output.schema.json"
        },
        "natal_cross": {
          "$ref": "draconic-cross-output.schema.json"
        },
        "draconic_cross": {
          "$ref": "draconic-cross-output.schema.json"
        }
      },
      "additionalProperties": false
    },
    "lots_context": {
      "type": "object",
      "required": [
        "authoring_projection_only",
        "creates_additional_evidence",
        "historical_technique_context_only",
        "output"
      ],
      "properties": {
        "authoring_projection_only": {
          "const": true
        },
        "creates_additional_evidence": {
          "const": false
        },
        "historical_technique_context_only": {
          "const": true
        },
        "output": {
          "$ref": "lots-output.schema.json"
        }
      },
      "additionalProperties": false
    },
    "surrender_vestal": {
      "type": "object",
      "additionalProperties": {
        "$ref": "surrender-vestal-output.schema.json"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "temporal_layer": {
      "type": "object",
      "required": [
        "status",
        "signal_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "CALCULATED",
            "NOT_EVALUABLE"
          ]
        },
        "signal_ids": {
          "type": "array",
