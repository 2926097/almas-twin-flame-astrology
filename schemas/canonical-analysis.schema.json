{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/canonical-analysis.schema.json",
  "title": "ALMAS · Análisis canónico",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_mode",
    "evidence",
    "models",
    "coverage",
    "robustness",
    "counterevidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "analysis_mode": {
      "enum": [
        "FULL",
        "TARGETED",
        "TEMPORAL",
        "REPORT"
      ]
    },
    "analysis_profile": {
      "enum": [
        "FULL_MULTIDISCIPLINARY",
        "FULL_ASTROLOGY",
        "TEMPORAL",
        "SOUL_CONTRACT"
      ]
    },
    "profile_policy_id": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "AF": {
          "$ref": "#/$defs/model_result"
        },
        "KA": {
          "$ref": "#/$defs/model_result"
        },
        "AG": {
          "$ref": "#/$defs/model_result"
        },
        "LG": {
          "$ref": "#/$defs/model_result"
        }
      },
      "additionalProperties": true
    },
    "indices": {
      "type": "object",
      "properties": {
        "IDD": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "IAT": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "ICC": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "IRC": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "ICE": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "coverage": {
      "type": "object"
    },
    "robustness": {
      "type": "object"
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ontology": {
      "type": "object"
    },
    "doctrine": {
      "type": "array",
      "items": {
        "$ref": "doctrinal-claim.schema.json"
      }
    },
    "temporal": {
      "type": "object",
      "properties": {
        "activation": {
          "$ref": "temporal-activation-output.schema.json"
        },
        "events": {
          "$ref": "documentary-event-output.schema.json"
        }
      },
      "additionalProperties": false
    },
    "semantic_motifs": {
      "type": "object"
    },
    "time_sensitivity": {
      "$ref": "time-sensitivity-output.schema.json"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ontological_discrimination": {
      "$ref": "ontological-discriminator-output.schema.json"
    },
    "pairwise_idd": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "idd",
          "band"
        ],
        "properties": {
          "idd": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "band": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "counterevidence_state": {
      "type": "object",
      "required": [
        "ice_evaluable",
        "ice_by_model",
        "essential_contradictions"
      ],
      "properties": {
        "ice_evaluable": {
          "type": "boolean"
        },
        "ice_by_model": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "AF",
                "KA",
                "AG",
                "LG"
              ],
              "properties": {
                "AF": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "KA": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "AG": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "LG": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "essential_contradictions": {
          "type": "object",
          "required": [
            "AF",
            "KA",
            "AG",
            "LG"
          ],
          "properties": {
            "AF": {
              "type": "boolean"
            },
            "KA": {
              "type": "boolean"
            },
            "AG": {
              "type": "boolean"
            },
            "LG": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "assembly": {
      "type": "object",
      "required": [
        "policy_id",
        "policy_status",
        "epistemic_class",
        "source",
        "analysis_profile",
        "recalculated_astrology",
        "recalculated_roots",
        "recalculated_pillars"
      ],
      "properties": {
        "policy_id": {
          "const": "ALMAS_CANONICAL_ASSEMBLY_V2"
        },
        "policy_status": {
          "type": "string",
          "minLength": 1
        },
        "epistemic_class": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "const": "M01_M29_CANONICAL_NAMESPACES"
        },
        "analysis_profile": {
          "type": "object"
        },
        "recalculated_astrology": {
          "const": false
        },
        "recalculated_roots": {
          "const": false
        },
        "recalculated_pillars": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "null_models": {
      "$ref": "null-model-output.schema.json"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "model_result": {
      "type": "object",
      "required": [
        "iem",
        "state"
      ],
      "properties": {
        "iem": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "state": {
          "enum": [
            "SUPPORTED",
            "COMPATIBLE",
            "INSUFFICIENT",
            "CONTRADICTED",
            "NOT_EVALUABLE"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "analysis_mode": {
            "const": "FULL"
          }
        },
        "required": [
          "analysis_mode"
        ]
      },
      "then": {
        "properties": {
          "models": {
            "required": [
              "AF",
              "KA",
              "AG",
              "LG"
            ]
          }
        }
      }
    }
  ]
}
