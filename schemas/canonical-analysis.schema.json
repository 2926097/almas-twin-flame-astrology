{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/canonical-analysis.schema.json",
  "title": "ALMAS · Análisis canónico",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_mode",
    "evidence",
    "models",
    "coverage",
    "robustness",
    "counterevidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "analysis_mode": {
      "enum": [
        "FULL",
        "TARGETED",
        "TEMPORAL",
        "REPORT"
      ]
    },
    "analysis_profile": {
      "enum": [
        "FULL_MULTIDISCIPLINARY",
        "FULL_ASTROLOGY",
        "TEMPORAL",
        "SOUL_CONTRACT"
      ]
    },
    "profile_policy_id": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "AF": {
          "$ref": "#/$defs/model_result"
        },
        "KA": {
          "$ref": "#/$defs/model_result"
        },
        "AG": {
          "$ref": "#/$defs/model_result"
        },
        "LG": {
          "$ref": "#/$defs/model_result"
        }
      },
      "additionalProperties": true
    },
    "indices": {
      "type": "object",
      "properties": {
        "IDD": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "IAT": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "ICC": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "IRC": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "ICE": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "coverage": {
      "type": "object"
    },
    "robustness": {
      "type": "object"
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ontology": {
      "type": "object"
    },
    "doctrine": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "temporal": {
      "type": "object"
    },
    "semantic_motifs": {
      "type": "object"
    },
    "time_sensitivity": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ontological_discrimination": {
      "$ref": "ontological-discriminator-output.schema.json"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "model_result": {
      "type": "object",
      "required": [
        "iem",
        "state"
      ],
      "properties": {
        "iem": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "state": {
          "enum": [
            "SUPPORTED",
            "COMPATIBLE",
            "INSUFFICIENT",
            "CONTRADICTED",
            "NOT_EVALUABLE"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "analysis_mode": {
            "const": "FULL"
          }
        },
        "required": [
          "analysis_mode"
        ]
      },
      "then": {
        "properties": {
          "models": {
            "required": [
              "AF",
              "KA",
              "AG",
              "LG"
            ]
          }
        }
      }
    }
  ]
}
