{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/astronomy-golden-result.schema.json",
  "title": "ALMAS · Resultado de validación astronómica dorada",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "case_set_id",
    "case_id",
    "backend_provenance",
    "reference_provenance",
    "measurements"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"const": "ALMAS_ASTRONOMY_GOLDEN_VALIDATION_V1"},
    "case_set_id": {"const": "ALMAS_ASTRONOMY_GOLDEN_CASES_V1"},
    "case_id": {"type": "string", "minLength": 1},
    "backend_provenance": {
      "type": "object",
      "required": ["adapter_id", "provider_version", "kernel_family", "kernel_sha256"],
      "properties": {
        "adapter_id": {"const": "ALMAS_MOIRA_JPL_SPK_V1"},
        "provider_version": {"const": "6.8.2"},
        "kernel_family": {"const": "DE440"},
        "kernel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "reference_provenance": {
      "type": "object",
      "required": ["method_id", "software", "software_version", "ephemeris_family"],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "software": {"type": "string", "minLength": 1},
        "software_version": {"type": "string", "minLength": 1},
        "ephemeris_family": {"const": "DE440"}
      },
      "additionalProperties": true
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric", "point_id", "implementation_deg", "reference_deg"],
        "properties": {
          "metric": {
            "enum": [
              "planetary_longitude",
              "ecliptic_latitude",
              "declination",
              "true_node_longitude",
              "angle_longitude",
              "house_cusp_longitude"
            ]
          },
          "point_id": {"type": "string", "minLength": 1},
          "implementation_deg": {"type": "number"},
          "reference_deg": {"type": "number"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
