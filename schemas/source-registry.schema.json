{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/source-registry.schema.json",
  "title": "ALMAS · Registro de fuentes",
  "type": "object",
  "required": [
    "registry_version",
    "entries"
  ],
  "properties": {
    "registry_version": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "source_role",
          "tradition",
          "author",
          "work",
          "concepts",
          "supports",
          "does_not_support",
          "verification_status",
          "source_id",
          "date",
          "passage",
          "historical_context",
          "dependency_root",
          "dependency_kind",
          "inferential_ceiling",
          "forbidden_upgrades",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "P1_PRIMARY",
              "P2_ACADEMIC",
              "P3_HISTORICAL_TECHNICAL",
              "P4_IDENTIFIED_METHOD",
              "P5_EMIC",
              "P6_WEAK_UNVERIFIED"
            ]
          },
          "source_role": {
            "enum": [
              "DOCTRINAL_PRIMARY",
              "ACADEMIC_ANALYSIS",
              "ACADEMIC_CONTEXT",
              "HISTORICAL_TECHNICAL",
              "IDENTIFIED_METHOD",
              "EMIC_USAGE",
              "LITERARY_PRIMARY",
              "LITERARY_ESOTERIC_PRIMARY",
              "LITERARY_CRITICISM",
              "HISTORICAL_RECEPTION",
              "LEXICAL_HISTORY",
              "WEAK_UNVERIFIED"
            ]
          },
          "tradition": {
            "type": [
              "string",
              "null"
            ]
          },
          "author": {
            "type": "string"
          },
          "work": {
            "type": "string"
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "date_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "passage": {
            "type": [
              "string",
              "null"
            ]
          },
          "pages": {
            "type": [
              "string",
              "null"
            ]
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "download_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "rights_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "local_file": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "concepts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "does_not_support": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "translation_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification_status": {
            "enum": [
              "VERIFIED_PRIMARY",
              "VERIFIED_METADATA",
              "PARTIAL",
              "PENDING"
            ]
          },
          "verification_anchor": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification_anchor_type": {
            "enum": [
              "EXACT_PASSAGE",
              "SECTION",
              "CHAPTER",
              "ABSTRACT",
              "TABLE_OF_CONTENTS",
              "AUTHOR_SUMMARY",
              "PUBLISHER_SUMMARY",
              "METADATA_ONLY",
              "TECHNICAL_EQUATION",
              null
            ]
          },
          "verification_anchor_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_scope": {
            "enum": [
              "DOCTRINAL_CLAIM",
              "METHOD_DESCRIPTION",
              "ACADEMIC_DESCRIPTION",
              "HISTORICAL_CONTEXT",
              "PHENOMENOLOGY",
              "BIBLIOGRAPHIC_ONLY",
              "TECHNICAL_METHOD",
              null
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "historical_context": {
            "type": "string",
            "minLength": 1
          },
          "dependency_root": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "dependency_kind": {
            "enum": [
              "UNRESOLVED",
              "DOCUMENTED_INFLUENCE",
              "CONSERVATIVE_DOCTRINAL_FAMILY"
            ]
          },
          "inferential_ceiling": {
            "enum": [
              "HISTORICAL_ANALOGY_ONLY",
              "DOCTRINAL_MODEL_ONLY",
              "PERSONAL_SYMBOLIC_CORRESPONDENCE",
              "RELATIONAL_ARCHITECTURE_COMPATIBLE",
              "PREINCARNATIONAL_CHOICE_ONLY",
              "NOT_ONTOLOGICAL_DISCRIMINATOR"
            ]
          },
          "forbidden_upgrades": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "DO_NOT_UPGRADE_TO_TWIN_FLAME",
                "DO_NOT_INFER_BILATERAL_CONTRACT",
                "DO_NOT_INFER_RECIPROCITY",
                "DO_NOT_INFER_REUNION",
                "DO_NOT_INFER_LITERAL_PAST_LIFE_IDENTITY"
              ]
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "registry_revision": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
