{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/relationship-chart-consonance.schema.json",
  "title": "ALMAS · Consonancia de cartas relacionales",
  "type": "object",
  "required": [
    "dependency_family",
    "policy",
    "contacts",
    "contact_count",
    "unavailable_points",
    "consonance_score",
    "score_state",
    "field_context"
  ],
  "properties": {
    "dependency_family": {
      "const": "RELCHART"
    },
    "policy": {
      "type": "object"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "contact_count": {
      "type": "integer",
      "minimum": 0
    },
    "unavailable_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consonance_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "score_state": {
      "const": "NOT_DEFINED"
    },
    "field_context": {
      "type": "object",
      "required": [
        "authoring_only",
        "structural_evidence_used",
        "creates_independent_roots",
        "aspect_policy_source",
        "point_ids",
        "composite",
        "davison",
        "cross_consonance_contact_count"
      ],
      "properties": {
        "authoring_only": {
          "const": true
        },
        "structural_evidence_used": {
          "const": false
        },
        "creates_independent_roots": {
          "const": false
        },
        "aspect_policy_source": {
          "const": "relationship_chart_consonance_policy.aspect_policy"
        },
        "point_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "composite": {
          "type": "object",
          "required": [
            "positions",
            "angles",
            "internal_contacts",
            "angle_contacts",
            "houses_calculated"
          ],
          "properties": {
            "positions": {
              "$ref": "#/$defs/zodiac_map"
            },
            "angles": {
              "$ref": "#/$defs/zodiac_map"
            },
            "internal_contacts": {
              "$ref": "#/$defs/internal_contacts"
            },
            "houses_calculated": {
              "const": false
            },
            "angle_contacts": {
              "$ref": "#/$defs/internal_contacts"
            }
          },
          "additionalProperties": false
        },
        "davison": {
          "type": "object",
          "required": [
            "positions",
            "angles",
            "house_cusps",
            "house_placements",
            "internal_contacts",
            "angle_contacts"
          ],
          "properties": {
            "positions": {
              "$ref": "#/$defs/zodiac_map"
            },
            "angles": {
              "$ref": "#/$defs/zodiac_map"
            },
            "house_cusps": {
              "$ref": "#/$defs/zodiac_map"
            },
            "internal_contacts": {
              "$ref": "#/$defs/internal_contacts"
            },
            "house_placements": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              }
            },
            "angle_contacts": {
              "$ref": "#/$defs/internal_contacts"
            }
          },
          "additionalProperties": false
        },
        "cross_consonance_contact_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "zodiac_position": {
      "type": "object",
      "required": [
        "longitude",
        "sign",
        "sign_index",
        "degree_in_sign"
      ],
      "properties": {
        "longitude": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "sign": {
          "enum": [
            "ARIES",
            "TAURUS",
            "GEMINI",
            "CANCER",
            "LEO",
            "VIRGO",
            "LIBRA",
            "SCORPIO",
            "SAGITTARIUS",
            "CAPRICORN",
            "AQUARIUS",
            "PISCES"
          ]
        },
        "sign_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "degree_in_sign": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 30
        },
        "point_type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "zodiac_map": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/zodiac_position"
      }
    },
    "internal_contact": {
      "type": "object",
      "required": [
        "subject_a",
        "point_a",
        "longitude_a",
        "subject_b",
        "point_b",
        "longitude_b",
        "aspect",
        "angle",
        "distance",
        "orb",
        "orb_limit",
        "exactness"
      ],
      "properties": {
        "subject_a": {
          "enum": [
            "RELCHART_COMPOSITE",
            "RELCHART_DAVISON"
          ]
        },
        "point_a": {
          "type": "string",
          "minLength": 1
        },
        "longitude_a": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "subject_b": {
          "enum": [
            "RELCHART_COMPOSITE",
            "RELCHART_DAVISON"
          ]
        },
        "point_b": {
          "type": "string",
          "minLength": 1
        },
        "longitude_b": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "aspect": {
          "type": "string",
          "minLength": 1
        },
        "angle": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "distance": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "orb": {
          "type": "number",
          "minimum": 0
        },
        "orb_limit": {
          "type": "number",
          "minimum": 0
        },
        "exactness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "internal_contacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/internal_contact"
      }
    }
  }
}
