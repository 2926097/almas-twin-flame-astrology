{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/validation-continuity-certificate.schema.json",
  "title": "ALMAS · Validation Continuity Certificate",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "policy_status",
    "epistemic_class",
    "validation_id",
    "candidate_id",
    "formula_ref",
    "cohort_id",
    "null_model",
    "preregistration_sha256",
    "opening_sha256",
    "holdout_evaluation_sha256",
    "holdout_distribution_fingerprint_sha256",
    "ledger_chain_head_sha256",
    "ledger_entry_count",
    "required_ledger_events_verified",
    "continuity_verified",
    "promotion_bridge_permitted",
    "private_payloads_exposed",
    "automatic_registry_mutation",
    "scoring_activation",
    "weighting_activation",
    "ontology_activation",
    "l3_validation",
    "metaphysical_probability"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"const": "ALMAS_VALIDATION_CONTINUITY_GATE_V1"},
    "policy_status": {"type": "string"},
    "epistemic_class": {"const": "E_PROJECT_POLICY"},
    "validation_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "formula_ref": {"type": "string", "minLength": 1},
    "cohort_id": {"type": "string", "minLength": 1},
    "null_model": {
      "enum": ["PAIR_SHUFFLE", "MATCHED_AGE", "MATCHED_AGE_CLOCK"]
    },
    "preregistration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "opening_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "holdout_evaluation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "holdout_distribution_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ledger_chain_head_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ledger_entry_count": {"type": "integer", "minimum": 3, "maximum": 5},
    "required_ledger_events_verified": {"const": true},
    "continuity_verified": {"const": true},
    "promotion_bridge_permitted": {"const": true},
    "private_payloads_exposed": {"const": false},
    "automatic_registry_mutation": {"const": false},
    "scoring_activation": {"const": false},
    "weighting_activation": {"const": false},
    "ontology_activation": {"const": false},
    "l3_validation": {"const": false},
    "metaphysical_probability": {"const": false}
  },
  "additionalProperties": false
}