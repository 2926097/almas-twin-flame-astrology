{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/almas/viability-reciprocity-output.schema.json",
  "title":"ALMAS Viability and Reciprocity Output",
  "type":"object",
  "required":[
    "assessment_ref",
    "as_of_date",
    "subjects",
    "real_viability",
    "reciprocity",
    "viability_basis",
    "reciprocity_basis",
    "viability_event_refs",
    "reciprocity_event_refs",
    "viability_subject_coverage",
    "reciprocity_subject_coverage",
    "factual_basis_only",
    "astrology_used_as_real_world_fact",
    "metaphysical_claim_used_as_real_world_fact",
    "phase_used_as_viability",
    "phenomenology_used_as_reciprocity_fact",
    "absence_used_as_asymmetry",
    "mental_states_inferred",
    "consent_inferred",
    "fidelity_inferred",
    "future_decisions_inferred"
  ],
  "properties":{
    "assessment_ref":{"type":"string","minLength":1},
    "as_of_date":{"type":"string","format":"date"},
    "subjects":{
      "type":"array",
      "minItems":2,
      "maxItems":2,
      "uniqueItems":true,
      "items":{"type":"string","minLength":1}
    },
    "real_viability":{
      "enum":[
        "UNKNOWN","STABLE","UNSTABLE","SEPARATED",
        "NON_ROMANTIC","NO_CONTACT","DEFINED_BY_FACTS"
      ]
    },
    "reciprocity":{
      "enum":["BILATERAL","PARTIAL","ASYMMETRIC","NOT_EVALUABLE"]
    },
    "viability_basis":{"type":"array","items":{"type":"object"}},
    "reciprocity_basis":{"type":"array","items":{"type":"object"}},
    "viability_event_refs":{
      "type":"array","uniqueItems":true,"items":{"type":"string"}
    },
    "reciprocity_event_refs":{
      "type":"array","uniqueItems":true,"items":{"type":"string"}
    },
    "viability_subject_coverage":{
      "type":"array","uniqueItems":true,"items":{"type":"string"}
    },
    "reciprocity_subject_coverage":{
      "type":"array","uniqueItems":true,"items":{"type":"string"}
    },
    "factual_basis_only":{"const":true},
    "astrology_used_as_real_world_fact":{"const":false},
    "metaphysical_claim_used_as_real_world_fact":{"const":false},
    "phase_used_as_viability":{"const":false},
    "phenomenology_used_as_reciprocity_fact":{"const":false},
    "absence_used_as_asymmetry":{"const":false},
    "mental_states_inferred":{"const":false},
    "consent_inferred":{"const":false},
    "fidelity_inferred":{"const":false},
    "future_decisions_inferred":{"const":false}
  },
  "additionalProperties":false
}
