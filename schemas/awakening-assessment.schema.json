{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://almas.example/schemas/awakening-assessment.schema.json",
  "title": "ALMAS · entrada de evaluación biográfica de awakening",
  "type": "object", "additionalProperties": false,
  "required": ["criteria"],
  "properties": {
    "criteria": {"type": "object", "additionalProperties": false,
      "required": ["explicit_reframing", "recognition_of_previous_pattern", "sustained_behavioral_change", "voluntary_reengagement", "increased_congruence_between_words_and_actions"],
      "properties": {
        "explicit_reframing": {"$ref": "#/$defs/criterion"},
        "recognition_of_previous_pattern": {"$ref": "#/$defs/criterion"},
        "sustained_behavioral_change": {"type": "object", "additionalProperties": false, "required": ["state", "evidence_refs"], "properties": {"state": {"enum": ["SUPPORTED", "CONTRADICTED", "NOT_EVALUABLE"]}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "observations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["fact_id", "actor", "occurred_on", "behavior_changed"], "properties": {"fact_id": {"type": "string", "minLength": 1}, "actor": {"enum": ["A", "B"]}, "occurred_on": {"type": "string", "format": "date"}, "behavior_changed": {"type": "boolean"}}}}}},
        "voluntary_reengagement": {"$ref": "#/$defs/criterion"},
        "increased_congruence_between_words_and_actions": {"$ref": "#/$defs/criterion"}
      }
    },
    "counterevidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "evidence_refs"], "properties": {"kind": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}}
  },
  "$defs": {"criterion": {"type": "object", "additionalProperties": false, "required": ["state", "evidence_refs"], "properties": {"state": {"enum": ["SUPPORTED", "CONTRADICTED", "NOT_EVALUABLE"]}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}}
}
