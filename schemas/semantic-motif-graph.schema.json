    "px": {
      "type": "object",
      "required": [
        "score",
        "strengths",
        "recurrent_motif_count",
        "components"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "recurrent_motif_count": {
          "type": "integer",
          "minimum": 0
        },
        "components": {
          "type": "object",
          "required": [
            "PX_G_EXACT_ROOT_RECURRENCE",
            "PX_S_SEMANTIC_RECURRENCE",
            "PX_R_RELCHART_CROSS_FAMILY",
            "PX_D_NATAL_DRACONIC_CROSS_FAMILY"
