              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "exact_multifamily_root_present": {
            "type": "boolean"
          },
          "recurrence_state": {
            "enum": [
              "RECURRENT",
              "SINGLE_FAMILY_OR_ROOT"
            ]
          },
          "motif_strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "includes_relchart": {
            "type": "boolean"
          },
          "includes_natal_draconic": {
