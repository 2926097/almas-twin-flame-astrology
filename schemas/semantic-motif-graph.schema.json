{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/semantic-motif-graph.schema.json",
  "title": "ALMAS · Grafo de motivos semánticos",
  "type": "object",
  "required": [
    "policy_id",
    "policy_status",
    "epistemic_class",
    "assignments",
    "primary_motifs",
    "mission_motifs",
    "recurrent_primary_motifs",
    "recurrent_mission_motifs",
    "px",
    "ps",
    "root_identity_mutated",
    "support_only_created_core_recurrence"
  ],
  "properties": {
    "policy_id": {
      "const": "ALMAS_SEMANTIC_MOTIF_V2"
    },
    "policy_status": {
      "const": "FROZEN_EXPERIMENTAL_BASELINE"
    },
    "epistemic_class": {
      "const": "E_PROJECT_HYPOTHESIS"
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "root_id",
          "primary_motif",
          "mission_motifs"
        ],
        "properties": {
          "root_id": {
            "type": "string"
          },
          "primary_motif": {
            "type": [
              "string",
              "null"
            ]
          },
          "mission_motifs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "primary_motifs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "motif_id",
          "motif_type",
          "root_ids",
          "root_count",
          "dependency_families",
          "independent_family_count",
          "family_strengths",
          "exact_multifamily_root_present",
          "recurrence_state",
          "motif_strength",
          "includes_relchart",
          "includes_natal_draconic"
        ],
        "properties": {
          "motif_id": {
            "type": "string",
            "minLength": 1
          },
          "motif_type": {
            "enum": [
              "PRIMARY",
              "MISSION"
            ]
          },
          "root_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "root_count": {
            "type": "integer",
            "minimum": 0
          },
          "dependency_families": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "independent_family_count": {
            "type": "integer",
            "minimum": 0
          },
          "family_strengths": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "exact_multifamily_root_present": {
            "type": "boolean"
          },
          "recurrence_state": {
            "enum": [
              "RECURRENT",
              "SINGLE_FAMILY_OR_ROOT"
            ]
          },
          "motif_strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "includes_relchart": {
            "type": "boolean"
          },
          "includes_natal_draconic": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "mission_motifs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "motif_id",
          "motif_type",
          "root_ids",
          "root_count",
          "dependency_families",
          "independent_family_count",
          "family_strengths",
          "exact_multifamily_root_present",
          "recurrence_state",
          "motif_strength",
