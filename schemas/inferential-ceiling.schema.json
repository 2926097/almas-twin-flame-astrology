{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/inferential-ceiling.schema.json",
  "title": "ALMAS · Casos sintéticos de techo inferencial",
  "type": "object",
  "required": [
    "schema_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "concept_id",
          "inputs",
          "requested_upgrade",
          "expected_ceiling",
          "expected_state",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "concept_id": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requested_upgrade": {
            "type": "string"
          },
          "expected_ceiling": {
            "type": "string"
          },
          "expected_state": {
            "enum": [
              "SUPPORTED",
              "COMPATIBLE",
              "INSUFFICIENT",
              "CONTRADICTED",
              "NOT_EVALUABLE"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
