{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/lots-output.schema.json",
  "title": "ALMAS · Salida de lotes helenísticos",
  "type": "object",
  "required": [
    "policy",
    "subjects"
  ],
  "properties": {
    "policy": {
      "type": "object"
    },
    "subjects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "status",
            "longitude",
            "source_ref"
          ],
          "properties": {
            "status": {
              "enum": [
                "CALCULATED",
                "NOT_EVALUABLE"
              ]
            },
            "longitude": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            "source_ref": {
              "type": "string",
              "minLength": 1
            },
            "formula": {
              "type": "object"
            },
            "sect": {
              "enum": [
                "DAY",
                "NIGHT",
                null
              ]
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    }
  },
  "additionalProperties": false
}
