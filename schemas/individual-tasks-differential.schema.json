{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/individual-tasks-differential.schema.json",
  "title": "ALMAS · Diferencial de tareas individuales",
  "type": "object",
  "required": [
    "schema_version",
    "subjects",
    "cross_activation",
    "counterevidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "subjects": {
      "type": "object",
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "$ref": "#/$defs/subjectTasks"
        },
        "B": {
          "$ref": "#/$defs/subjectTasks"
        }
      },
      "additionalProperties": false
    },
    "cross_activation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "receiver",
          "task_id",
          "activator",
          "root_refs",
          "state"
        ],
        "properties": {
          "receiver": {
            "enum": [
              "A",
              "B"
            ]
          },
          "task_id": {
            "type": "string"
          },
          "activator": {
            "enum": [
              "A",
              "B"
            ]
          },
          "root_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "enum": [
              "SUPPORTED",
              "COMPATIBLE",
              "INSUFFICIENT",
              "CONTRADICTED",
              "NOT_EVALUABLE"
            ]
          }
        }
      }
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "subjectTasks": {
      "type": "object",
      "required": [
        "state",
        "primary_tasks",
        "secondary_tasks",
        "tasks",
        "evidence_families",
        "partner_removed_result",
        "counterevidence",
        "why_not_more_specific"
      ],
      "properties": {
        "state": {
          "enum": [
            "PREVIA_FUERTE",
            "PREVIA_COMPATIBLE",
            "PREVIA_INSUFICIENTE",
            "PREVIA_CONTRADICTED",
            "PREVIA_NO_EVALUABLE"
          ]
        },
        "primary_tasks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "secondary_tasks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "state",
              "independent_natal_roots",
              "reason_not_higher"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "SUPPORTED",
                  "COMPATIBLE",
                  "INSUFFICIENT",
                  "CONTRADICTED",
                  "NOT_EVALUABLE"
                ]
              },
              "independent_natal_roots": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "coverage": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "robustness": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "r_min": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "counterevidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reason_not_higher": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "evidence_families": {
          "type": "array",
          "items": {
            "enum": [
              "ITF1_RADIX_DOMINANTE",
              "ITF2_NODOS_Y_REGENTES",
              "ITF3_DISPOSITORES",
              "ITF4_POLARIDAD_REPETIDA",
              "ITF5_DRACONICA_INDIVIDUAL",
              "ITF6_ROBUSTEZ_HORARIA",
              "ITF7_HISTORIA_DOCUMENTADA",
              "ITF8_INDEPENDENCIA_DEL_OTRO"
            ]
          },
          "uniqueItems": true
        },
        "partner_removed_result": {
          "enum": [
            "PRESERVED",
            "WEAKENED",
            "COLLAPSED",
            "NOT_EVALUABLE"
          ]
        },
        "ablation_result": {
          "type": [
            "string",
            "null"
          ]
        },
        "counterevidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "robustness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "why_selected": {
          "type": [
            "string",
            "null"
          ]
        },
        "why_not_more_specific": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
