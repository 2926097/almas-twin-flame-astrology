{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/almas/report-gate-output.schema.json",
  "title":"ALMAS Report Gate Output",
  "type":"object",
  "required":[
    "gate_version",
    "state",
    "reportable",
    "source",
    "canonical_fingerprint",
    "canonical_schema_checked",
    "canonical_source_conflict",
    "analysis_mode",
    "missing_fields",
    "blocking_issues",
    "degradation_reasons",
    "execution_trace_state",
    "completed_modules",
    "failed_modules",
    "not_evaluable_modules",
    "skipped_modules",
    "not_applicable_modules",
    "canonical_values_mutated"
  ],
  "properties":{
    "gate_version":{"const":"1.0.0"},
    "state":{"enum":["READY","PARTIAL","BLOCKED"]},
    "reportable":{"type":"boolean"},
    "source":{"enum":["RAW_INPUT","CANONICAL_SNAPSHOT","CONFLICT",null]},
    "canonical_fingerprint":{"type":["string","null"]},
    "canonical_schema_checked":{"type":"boolean"},
    "canonical_source_conflict":{"type":"boolean"},
    "analysis_mode":{"type":["string","null"]},
    "missing_fields":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "blocking_issues":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "degradation_reasons":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "execution_trace_state":{"enum":["AVAILABLE","UNAVAILABLE"]},
    "completed_modules":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "failed_modules":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "not_evaluable_modules":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "skipped_modules":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "not_applicable_modules":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "canonical_values_mutated":{"const":false}
  },
  "allOf":[
    {
      "if":{"properties":{"state":{"const":"READY"}}},
      "then":{
        "properties":{
          "reportable":{"const":true},
          "blocking_issues":{"maxItems":0},
          "degradation_reasons":{"maxItems":0}
        }
      }
    },
    {
      "if":{"properties":{"state":{"const":"PARTIAL"}}},
      "then":{
        "properties":{
          "reportable":{"const":true},
          "blocking_issues":{"maxItems":0},
          "degradation_reasons":{"minItems":1}
        }
      }
    },
    {
      "if":{"properties":{"state":{"const":"BLOCKED"}}},
      "then":{
        "properties":{
          "reportable":{"const":false},
          "blocking_issues":{"minItems":1}
        }
      }
    }
  ],
  "additionalProperties":false
}
