{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/concept-registry.schema.json",
  "title": "ALMAS Concept Registry",
  "type": "object",
  "required": [
    "registry_version",
    "almas_version",
    "concepts"
  ],
  "properties": {
    "registry_version": {
      "type": "string"
    },
    "almas_version": {
      "type": "string"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label_es",
          "definition",
          "not_equivalent_to",
          "almas_use"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label_es": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "primary_sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "academic_sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "method_sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "not_equivalent_to": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "almas_use": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
