{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/concept-registry.schema.json",
  "title": "ALMAS · Registro de conceptos",
  "type": "object",
  "required": [
    "registry_version",
    "almas_version",
    "concepts"
  ],
  "properties": {
    "registry_version": {
      "type": "string"
    },
    "almas_version": {
      "type": "string"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label_es",
          "definition",
          "concept_class",
          "status",
          "primary_sources",
          "academic_sources",
          "method_sources",
          "historical_sources",
          "not_equivalent_to",
          "almas_use"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label_es": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "concept_class": {
            "enum": [
              "DOCTRINAL_ANALYTIC",
              "DOCTRINAL_FRAMEWORK",
              "TECHNICAL_METHOD",
              "PHENOMENOLOGY",
              "HISTORICAL_GENEALOGY",
              "ACADEMIC_CONTEXT",
              "CONTEMPORARY_MODEL",
              "BOUNDARY",
              "PROJECT_MODEL"
            ]
          },
          "status": {
            "enum": [
              "DEFINED",
              "DEFINED_FOR_DISCRIMINATION",
              "PROVISIONAL",
              "DEPRECATED"
            ]
          },
          "primary_sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "academic_sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "method_sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "historical_sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "not_equivalent_to": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "almas_use": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
