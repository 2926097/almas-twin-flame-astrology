{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/validation-release-audit-package.schema.json",
  "title": "ALMAS · Paquete de auditoría de versión",
  "type": "object",
  "required": [
    "schema_version", "policy_id", "policy_status", "epistemic_class",
    "validation_id", "candidate_id", "formula_ref", "cohort_id",
    "release_audit_ref", "reviewer_refs", "preregistration_sha256",
    "opening_sha256", "holdout_evaluation_sha256",
    "holdout_distribution_fingerprint_sha256",
    "continuity_certificate_sha256", "documentary_reveal_sha256",
    "promotion_result_sha256", "validation_closure_sha256",
    "closed_ledger_chain_head_sha256", "closed_ledger_entry_count",
    "validation_outcome", "release_audit_ready", "private_payloads_exposed",
    "manual_release_review_required",
    "manual_new_version_required_for_activation",
    "same_release_activation_forbidden", "automatic_registry_mutation",
    "scoring_activation", "weighting_activation", "ontology_activation",
    "l3_validation", "metaphysical_probability"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"const": "ALMAS_VALIDATION_CLOSURE_RELEASE_AUDIT_V1"},
    "policy_status": {"type": "string"},
    "epistemic_class": {"const": "E_PROJECT_POLICY"},
    "validation_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "formula_ref": {"type": "string", "minLength": 1},
    "cohort_id": {"type": "string", "minLength": 1},
    "release_audit_ref": {"type": "string", "minLength": 1},
    "reviewer_refs": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "preregistration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "opening_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "holdout_evaluation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "holdout_distribution_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "continuity_certificate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "documentary_reveal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "promotion_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_closure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "closed_ledger_chain_head_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "closed_ledger_entry_count": {"const": 5},
    "validation_outcome": {
      "enum": [
        "PROMOTION_ELIGIBLE_AWAITING_VERSIONED_ACTIVATION",
        "CLOSED_NOT_ELIGIBLE"
      ]
    },
    "release_audit_ready": {"const": true},
    "private_payloads_exposed": {"const": false},
    "manual_release_review_required": {"const": true},
    "manual_new_version_required_for_activation": {"const": true},
    "same_release_activation_forbidden": {"const": true},
    "automatic_registry_mutation": {"const": false},
    "scoring_activation": {"const": false},
    "weighting_activation": {"const": false},
    "ontology_activation": {"const": false},
    "l3_validation": {"const": false},
    "metaphysical_probability": {"const": false}
  },
  "additionalProperties": false
}
