{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/structural-policy-manifest.schema.json",
  "title": "ALMAS · Manifiesto de políticas estructurales",
  "type": "object",
  "required": [
    "manifest_version",
    "manifest_id",
    "almas_public_version",
    "status",
    "purpose",
    "contracts",
    "invariants"
  ],
  "properties": {
    "manifest_version": {"const": "1.0.0"},
    "manifest_id": {"const": "ALMAS_STRUCTURAL_POLICY_MANIFEST_V1"},
    "almas_public_version": {"const": "1.20.0"},
    "status": {"const": "FROZEN_NORMATIVE"},
    "purpose": {"type": "string", "minLength": 1},
    "contracts": {
      "type": "object",
      "required": [
        "technique_dependency_registry",
        "declared_orb_contract",
        "structural_loading_contract",
        "root_strength",
        "root_pillar_attribution"
      ],
      "additionalProperties": false,
      "properties": {
        "technique_dependency_registry": {"$ref": "#/$defs/contract"},
        "declared_orb_contract": {"$ref": "#/$defs/contract"},
        "structural_loading_contract": {"$ref": "#/$defs/contract"},
        "root_strength": {"$ref": "#/$defs/contract"},
        "root_pillar_attribution": {"$ref": "#/$defs/contract"}
      }
    },
    "invariants": {
      "type": "object",
      "required": [
        "no_new_analytical_module",
        "no_score_change",
        "no_implicit_orbs",
        "no_runtime_case_fitting",
        "support_only_cannot_create_core",
        "dependency_deduplication_precedes_root_construction",
        "birth_time_robustness_remains_m23_m25"
      ],
      "additionalProperties": false,
      "properties": {
        "no_new_analytical_module": {"const": true},
        "no_score_change": {"const": true},
        "no_implicit_orbs": {"const": true},
        "no_runtime_case_fitting": {"const": true},
        "support_only_cannot_create_core": {"const": true},
        "dependency_deduplication_precedes_root_construction": {"const": true},
        "birth_time_robustness_remains_m23_m25": {"const": true}
      }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "required": ["policy_id", "path", "consumers"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "input_schema": {"type": "string", "minLength": 1},
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
