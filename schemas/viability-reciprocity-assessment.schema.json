{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/viability-reciprocity-assessment.schema.json",
  "title": "ALMAS · Evaluación factual de viabilidad y reciprocidad",
  "type": "object",
  "required": [
    "assessment_ref",
    "as_of_date",
    "subjects",
    "real_viability",
    "reciprocity"
  ],
  "properties": {
    "assessment_ref": {
      "type": "string",
      "minLength": 1
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "subjects": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "real_viability": {
      "enum": [
        "UNKNOWN",
        "STABLE",
        "UNSTABLE",
        "SEPARATED",
        "NON_ROMANTIC",
        "NO_CONTACT",
        "DEFINED_BY_FACTS"
      ]
    },
    "reciprocity": {
      "enum": [
        "BILATERAL",
        "PARTIAL",
        "ASYMMETRIC",
        "NOT_EVALUABLE"
      ]
    },
    "viability_basis": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/basis"
      }
    },
    "reciprocity_basis": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/basis"
      }
    }
  },
  "$defs": {
    "basis": {
      "type": "object",
      "required": [
        "event_id",
        "basis_kind",
        "observation_type",
        "subject_ids"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "basis_kind": {
          "enum": [
            "OBSERVED_STABLE_RELATIONSHIP",
            "OBSERVED_UNSTABLE_RELATIONSHIP",
            "DOCUMENTED_SEPARATION",
            "EXPLICIT_NON_ROMANTIC_DEFINITION",
            "DOCUMENTED_NO_CONTACT",
            "OTHER_DOCUMENTED_RELATIONSHIP_FORM",
            "DOCUMENTED_BILATERALITY",
            "DOCUMENTED_PARTIAL_RECIPROCITY",
            "DOCUMENTED_ASYMMETRY"
          ]
        },
        "observation_type": {
          "enum": [
            "EXPLICIT_STATEMENT",
            "OBSERVABLE_ACTION",
            "MUTUAL_AGREEMENT",
            "BOUNDARY_OR_REFUSAL",
            "DOCUMENTED_STATUS"
          ]
        },
        "subject_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
