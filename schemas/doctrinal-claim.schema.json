{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/doctrinal-claim.schema.json",
  "title": "ALMAS Doctrinal / Metaphysical Claim v2",
  "type": "object",
  "required": [
    "schema_version",
    "claim_id",
    "statement",
    "epistemic_class",
    "claim_scope",
    "source_relation",
    "source_ids",
    "source_anchor_refs",
    "status",
    "limitations",
    "inferential_ceiling",
    "discriminator_state",
    "allowed_conclusion",
    "ceiling_enforced"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "claim_id": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "epistemic_class": {
      "enum": [
        "A_CALCULATED",
        "B_TECHNIQUE",
        "C_DOCTRINE",
        "D_CONTEMPORARY_USAGE",
        "E_PROJECT_HYPOTHESIS"
      ]
    },
    "claim_scope": {
      "enum": [
        "CALCULATED_FACT",
        "TECHNIQUE_DESCRIPTION",
        "DOCTRINAL_ATTRIBUTION",
        "CONTEMPORARY_USAGE",
        "PROJECT_OPERATIONALIZATION",
        "PROJECT_SYNTHESIS"
      ]
    },
    "concept_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_relation": {
      "enum": [
        "DIRECT_DOCTRINE",
        "ACADEMIC_DESCRIPTION",
        "HISTORICAL_ANTECEDENT",
        "COMPARATIVE_ANALOGUE",
        "CONTEMPORARY_USAGE",
        "PROJECT_OPERATIONALIZATION",
        "PROJECT_SYNTHESIS"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_anchor_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "astrological_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "SUPPORTED",
        "COMPATIBLE",
        "INSUFFICIENT",
        "CONTRADICTED",
        "NOT_EVALUABLE"
      ]
    },
    "requested_conclusion": {
      "type": [
        "string",
        "null"
      ]
    },
    "allowed_conclusion": {
      "type": "string"
    },
    "inferential_ceiling": {
      "type": "string"
    },
    "discriminator_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "discriminator_state": {
      "enum": [
        "VALIDATED",
        "OPERATIONAL_FUNCTIONAL_ONLY",
        "OPERATIONAL_EPISTEMIC",
        "DOCTRINAL_ONLY",
        "NOT_VALIDATED",
        "NOT_APPLICABLE"
      ]
    },
    "ceiling_enforced": {
      "const": true
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_support_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "support_index"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "support_index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "does_not_support_checked": {
      "type": "boolean"
    },
    "asserts_doctrinal_identity": {
      "type": "boolean"
    },
    "identity_target_concept_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "epistemic_class": {
            "const": "C_DOCTRINE"
          },
          "source_relation": {
            "const": "DIRECT_DOCTRINE"
          }
        },
        "required": [
          "epistemic_class",
          "source_relation"
        ]
      },
      "then": {
        "required": [
          "source_support_refs",
          "does_not_support_checked"
        ],
        "properties": {
          "source_support_refs": {
            "minItems": 1
          },
          "does_not_support_checked": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asserts_doctrinal_identity": {
            "const": true
          }
        },
        "required": [
          "asserts_doctrinal_identity"
        ]
      },
      "then": {
        "required": [
          "concept_id",
          "identity_target_concept_id"
        ],
        "properties": {
          "concept_id": {
            "type": "string",
            "minLength": 1
          },
          "identity_target_concept_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
