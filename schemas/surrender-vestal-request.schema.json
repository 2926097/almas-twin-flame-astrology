{
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "window_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observation_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "enum": [
              "ABSTINENCE_DECLARED",
              "AUTONOMY_RECOVERED",
              "CELIBACY_CHOSEN",
              "CHECKING_REDUCED",
              "EROTIC_DECENTERING",
              "IDEALIZATION_PERSISTENT",
              "INTERNAL_COMPULSION",
              "LABEL_COMPULSION",
              "LABEL_NEED_REDUCED",
              "OUTCOMES_ACCEPTED",
              "OWN_ACTIVITIES_RECOVERED",
              "PURSUIT_CEASED",
              "PURSUIT_PERSISTENT",
              "REACTIVE_ABSTINENCE",
              "SEXUALITY_TO_FORCE_UNION",
              "SUBSTITUTION_REDUCED",
              "SURVEILLANCE",
              "UNCERTAINTY_ACCEPTED",
              "WAITING_FOR_UNION",
              "WITHDRAWAL_ABSENT"
            ]
          },
          "value": {
            "type": "boolean"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "documentary_quality": {
            "type": "string",
            "minLength": 1
          },
          "fact_interpretation_separated": {
            "type": "boolean"
          },
          "event_ref": {
            "type": "string",
            "minLength": 1
          },
          "record_status": {
            "enum": [
              "ACTIVE",
              "SUPERSEDED"
            ]
          }
        },
        "required": [
          "observation_id",
          "subject_id",
          "code",
          "value",
          "date",
          "source_refs",
          "documentary_quality",
          "fact_interpretation_separated"
        ],
        "additionalProperties": false
      }
    },
    "structural_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "root_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "root_id",
          "subject_id",
          "source_refs",
          "verified"
        ],
        "additionalProperties": false
      }
    },
    "temporal_activations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signal_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "root_id": {
            "type": "string",
            "minLength": 1
          },
          "technique": {
            "enum": [
              "TRANSIT",
              "SECONDARY_PROGRESSION",
              "SOLAR_ARC",
              "DIRECTION",
              "ATACIR",
              "DRACONIC",
              "ANTISCIA",
              "DECLINATION"
            ]
          },
          "symbolic_family": {
            "enum": [
              "VESTA",
              "SATURN",
              "VENUS_MARS",
              "NODAL",
              "CHIRON",
              "URANUS_PLUTO",
              "NEPTUNE"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependency_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "orb": {
            "type": "number",
            "minimum": 0
          },
          "declared_orb": {
            "type": "number",
            "minimum": 0
          },
          "aspect_policy_ref": {
            "type": "string",
            "minLength": 1
          },
          "verified": {
            "type": "boolean"
          },
          "temporal_correspondence_documented": {
            "type": "boolean"
          }
        },
        "required": [
          "signal_id",
          "subject_id",
          "root_id",
          "technique",
          "symbolic_family",
          "date",
          "source_refs",
          "dependency_keys",
          "orb",
          "declared_orb",
          "aspect_policy_ref",
          "verified",
          "temporal_correspondence_documented"
        ],
        "additionalProperties": false
      }
    },
    "doctrinal_source_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "subject_id",
    "window_start",
    "window_end"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/surrender-vestal-request.schema.json",
  "title": "ALMAS · Solicitud de surrender y retirada vestal"
}
