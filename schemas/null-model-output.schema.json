{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/almas/null-model-output.schema.json",
  "title": "ALMAS · Salida de modelos nulos",
  "type": "object",
  "required": [
    "runs",
    "run_count",
    "metaphysical_probability",
    "sampling_generated_by_m24"
  ],
  "properties": {
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "preregistration_ref",
          "null_model",
          "feature_set_ref",
          "orb_policy_ref",
          "event_set_ref",
          "generator_ref",
          "statistic_id",
          "observed_value",
          "tail",
          "n",
          "extreme_count",
          "structural_frequency",
          "wilson_interval",
          "evaluation_source",
          "sampling_generated_by_m24",
          "interpretation_scope"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "preregistration_ref": {"type": "string", "minLength": 1},
          "null_model": {
            "enum": [
              "MATCHED_AGE",
              "WITHIN_YEAR",
              "MATCHED_AGE_CLOCK",
              "EPHEMERIS_DATE",
              "PAIR_SHUFFLE",
              "EVENT_DATE_SHIFT",
              "TECHNIQUE_SPECIFIC_CYCLE"
            ]
          },
          "feature_set_ref": {"type": "string", "minLength": 1},
          "orb_policy_ref": {"type": "string", "minLength": 1},
          "event_set_ref": {"type": "string", "minLength": 1},
          "generator_ref": {"type": "string", "minLength": 1},
          "statistic_id": {"type": "string", "minLength": 1},
          "observed_value": {"type": "number"},
          "tail": {
            "enum": [
              "GREATER_OR_EQUAL",
              "LESS_OR_EQUAL",
              "ABS_GREATER_OR_EQUAL"
            ]
          },
          "n": {"type": "integer", "minimum": 1},
          "extreme_count": {"type": "integer", "minimum": 0},
          "structural_frequency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "wilson_interval": {
            "type": "object",
            "required": [
              "confidence_level",
              "lower",
              "upper"
            ],
            "properties": {
              "confidence_level": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "lower": {"type": "number", "minimum": 0, "maximum": 1},
              "upper": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "additionalProperties": false
          },
          "evaluation_source": {
            "enum": [
              "NULL_SAMPLES",
              "PRECOMPUTED_COUNTS"
            ]
          },
          "sampling_generated_by_m24": {
            "type": "boolean"
          },
          "generator_policy_id": {
            "type": "string",
            "minLength": 1
          },
          "interpretation_scope": {
            "const": "STRUCTURAL_FREQUENCY_UNDER_DECLARED_NULL"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "sampling_generated_by_m24": {"const": true}
              },
              "required": ["sampling_generated_by_m24"]
            },
            "then": {
              "required": ["generator_policy_id"]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "run_count": {"type": "integer", "minimum": 1},
    "metaphysical_probability": {"const": false},
    "sampling_generated_by_m24": {"type": "boolean"},
    "generator_policy_id": {"type": "string"},
    "generator_policy_status": {"type": "string"},
    "epistemic_class": {"type": "string"},
    "generated_sample_count": {"type": "integer", "minimum": 1},
    "samples_per_subject": {"type": "integer", "minimum": 1},
    "sample_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "perturbed_subject_id",
          "replacement_birth_date",
          "core_root_count",
          "max_iem_pre",
          "px_pillar_score"
        ],
        "properties": {
          "perturbed_subject_id": {"type": "string", "minLength": 1},
          "replacement_birth_date": {"type": "string", "format": "date"},
          "core_root_count": {"type": "integer", "minimum": 1},
          "max_iem_pre": {"type": "number", "minimum": 0, "maximum": 100},
          "px_pillar_score": {"type": "number", "minimum": 0, "maximum": 100}
        },
        "additionalProperties": false
      }
    },
    "recurrence_calibration": {
      "type": "object",
      "required": [
        "state",
        "policy_id",
        "policy_status",
        "epistemic_class",
        "used_for_weighting",
        "used_in_px_score",
        "used_in_ps_score",
        "used_in_iem",
        "used_in_idd",
        "used_in_irc",
        "used_in_ontology",
        "metaphysical_probability",
        "external_population_claim"
      ],
      "properties": {
        "state": {
          "enum": ["DIAGNOSTIC_ONLY", "NOT_EVALUABLE"]
        },
        "policy_id": {
          "const": "ALMAS_RECURRENCE_NULL_CALIBRATION_V1"
        },
        "policy_status": {"type": "string"},
        "epistemic_class": {"type": "string"},
        "reason": {"type": "string"},
        "null_model": {"type": "string"},
        "null_generator_policy_id": {"type": "string"},
        "sample_count": {"type": "integer", "minimum": 1},
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "observed_motifs": {
          "type": "array",
          "items": {"type": "object"}
        },
        "null_catalog": {"type": "object"},
        "aggregate": {"type": "object"},
        "used_for_weighting": {"const": false},
        "used_in_px_score": {"const": false},
        "used_in_ps_score": {"const": false},
        "used_in_iem": {"const": false},
        "used_in_idd": {"const": false},
        "used_in_irc": {"const": false},
        "used_in_ontology": {"const": false},
        "metaphysical_probability": {"const": false},
        "external_population_claim": {"const": false},
        "combined_p_value": {"type": "null"},
        "combined_p_value_state": {"const": "FORBIDDEN"},
        "multiple_testing_correction_state": {
          "enum": ["NOT_CLAIMED"]
        },
        "external_nulls_required_before_weighting": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "external_population_claim": {"const": false},
    "combined_p_value": {"type": "null"},
    "combined_p_value_state": {"const": "FORBIDDEN"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sampling_generated_by_m24": {"const": true}
        },
        "required": ["sampling_generated_by_m24"]
      },
      "then": {
        "required": [
          "generator_policy_id",
          "generator_policy_status",
          "epistemic_class",
          "generated_sample_count",
          "samples_per_subject",
          "sample_manifest",
          "recurrence_calibration",
          "external_population_claim",
          "combined_p_value",
          "combined_p_value_state"
        ]
      }
    }
  ],
  "additionalProperties": false
}